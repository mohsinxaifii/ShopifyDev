<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %}
      Libre Baskerville is a variable family (wght 400-700) but Shopify's library
      only carries static 400 and 700 instances. The designs set every display
      serif at 600, which against those two can only resolve to 700 - visibly
      heavier than the artwork. Google serves the real 600, so the serif is
      loaded from there for as long as it stays Libre Baskerville; pick any other
      serif in theme settings and this drops out, leaving Shopify's own faces
      (emitted by css-variables) to take over.
    {% endcomment %}
    {% if settings.type_tertiary_font.family contains 'Libre Baskerville' %}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&display=swap"
      >
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'motion.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'variant-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'skeleton.css' | asset_url | stylesheet_tag }}

    {% comment %}
      Set before first paint so the reveal's hidden state applies to the very
      first frame - added by script rather than written into the markup so that
      a visitor with JS off, or with reduced motion asked for, never gets a
      stylesheet that hides content with nothing left to reveal it.
    {% endcomment %}
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Drag (mouse) and swipe (touch) for every carousel - before any section script %}
    <script src="{{ 'swipe.js' | asset_url }}" defer="defer"></script>

    {% # Event tracking (GA4 + Meta) - before content_for_header, see the snippet %}
    {% render 'analytics-config' %}

    {%- comment -%}
      GoKwik checkout (settings > Gokwik), as on the live theme. It must come
      after analytics-config: GoKwik takes over every "Checkout" / "Buy now"
      button with a capture listener that stops the click, and only a listener
      registered before it still sees that click.
    {%- endcomment -%}
    <link rel="dns-prefetch" href="https://pdp.gokwik.co/">
    <link rel="dns-prefetch" href="https://api.gokwik.co">
    {% render 'gokwik' %}
    {% render 'kwikpass-account-guard' %}

    {% # OpenAI (ChatGPT) Ads pixel, as on the live theme (settings > OpenAI Ads) %}
    {% render 'openai-ads-pixel' %}
    {%- if settings.openai_ads_enabled -%}
      <script src="{{ 'openai-ads.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% # Cart drawer: one per page, opened by every add-to-cart in the theme %}
    {% render 'cart-drawer' %}

    {% # Variant picker: every add-to-cart for a product with options asks here first %}
    {% render 'variant-drawer' %}

    <script>
      window.themeStrings = {
        adding: {{ 'cart.adding' | t | json }},
        added: {{ 'cart.added' | t | json }},
        failed: {{ 'cart.failed' | t | json }},
        wishlistRemove: {{ 'accessibility.wishlist_remove' | t | json }},
        {% comment %}
          A sentinel rather than the locale's own {{ count }} placeholder:
          nested output tags do not survive the Liquid lexer, and the count is
          only known once wishlist.js has read the store.
        {% endcomment %}
        wishlistCount: {{ 'wishlist.item_count' | t: count: '__COUNT__' | json }},
        wishlistCountOne: {{ 'wishlist.item_count_one' | t | json }},
        contactCopied: {{ 'contact.copied' | t | json }},
      };
      // wishlist.js sends a signed-out shopper to sign in before adding.
      window.zinaraCustomer = {% if customer %}true{% else %}false{% endif %};
    </script>
    {%- comment -%}
      Wishlist sync (wishlist.js <-> zinara-wishlist on the server). For a
      logged-in customer, Liquid signs "<customer id>:<time>" with the secret
      kept in the shop metafield zinara_wishlist.signing_secret, so the server
      can trust which customer is asking. The secret itself is never output.
    {%- endcomment -%}
    {%- if customer and settings.wishlist_endpoint != blank -%}
      {%- assign wishlist_secret = shop.metafields.zinara_wishlist.signing_secret.value -%}
      {%- if wishlist_secret != blank -%}
        {%- assign wishlist_ts = 'now' | date: '%s' -%}
        {%- capture wishlist_payload -%}{{ customer.id }}:{{ wishlist_ts }}{%- endcapture -%}
        <script>
          window.zinaraWishlistAccount = {
            endpoint: {{ settings.wishlist_endpoint | json }},
            customer: {{ customer.id | json }},
            ts: {{ wishlist_ts | json }},
            sig: {{ wishlist_payload | hmac_sha256: wishlist_secret | json }},
          };
        </script>
      {%- endif -%}
    {%- endif -%}
    {%- comment -%}
      Judge.me is the only source of ratings and reviews. judgeme.js reads them
      from Judge.me's widget API with the shop's public token, which is meant to
      be exposed - the private token must never be used here.
    {%- endcomment -%}
    {%- if settings.judgeme_public_token != blank -%}
      <script>
        window.zinaraJudgeme = {
          shopDomain: {{ shop.permanent_domain | json }},
          token: {{ settings.judgeme_public_token | strip | json }},
        };
      </script>
      <script src="{{ 'judgeme.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'variant-drawer.js' | asset_url }}" defer="defer"></script>

    {% comment %}
      Animation engine. animations.js waits for these and falls back to showing
      everything outright if the CDN is blocked, so the order matters but the
      arrival does not.
    {% endcomment %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"></script>
    <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

    {% comment %}
      Lifts the loading placeholders once the page has settled. Loaded for every
      page because most templates carry one; skeleton.css keeps a CSS timeout
      behind it either way.
    {% endcomment %}
    <script src="{{ 'skeleton.js' | asset_url }}" defer="defer"></script>
      {% # KwikPass: GoKwik's phone-OTP login, as on the live theme %}
    {% render 'kwikpass' %}
  </body>
</html>
