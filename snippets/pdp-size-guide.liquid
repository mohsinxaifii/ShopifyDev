{%- doc -%}
  Ring size guide sheet - a sidesheet on desktop, a bottom sheet on phones.
  Figma Mobile 8106:60328 (Size guide bottomsheet).

  One guide for every ring, kept in the shop's "Ring size guide" metaobject
  (type `ring_size_guide`, entry `ring-size-guide`), so it is edited in the
  admin rather than per product:
  - title            single line text    sheet heading
  - measure_heading  single line text    above the photo
  - measure_image    file (image)        only for a ring with no photo of its
                                         own - the photo is the ring's featured
                                         image
  - chart_heading    single line text    above the table
  - columns          list of single line the three column headings
  - rows             list of single line one row each, cells split by "|"
                                         e.g. "8 | 48.1 | 15"
  - cta_label        single line text    the WhatsApp button

  Any field left empty falls back to the Figma copy below, so the sheet is
  complete before the entry exists.

  @param {object} product - the ring; its featured image is the photo
  @param {string} [whatsapp_url] - the footer CTA's link; no button without it
{%- enddoc -%}

{%- liquid
  comment
    The `ring-size-guide` entry, or failing that whichever one there is - the
    values list is paginated, so `.first` on it comes back empty.
  endcomment
  assign guide = metaobjects.ring_size_guide['ring-size-guide']
  if guide == blank
    for entry in metaobjects.ring_size_guide.values limit: 1
      assign guide = entry
    endfor
  endif

  assign guide_title = guide.title.value | default: 'Size guide'
  assign measure_heading = guide.measure_heading.value | default: 'How to measure your ring size'
  assign measure_image = product.featured_image | default: guide.measure_image.value
  assign chart_heading = guide.chart_heading.value | default: 'Size chart'
  assign cta_label = guide.cta_label.value | default: 'Whatsapp us'

  assign columns = guide.columns.value
  if columns == blank
    assign columns = 'RING SIZE|Circumference (mm)|Diameter (mm)' | split: '|'
  endif

  assign rows = guide.rows.value
  if rows == blank
    assign rows = '8 | 48.1 | 15,9 | 49.0 | 15.4,10 | 50.0 | 15.7,11 | 50.9 | 16,12 | 51.8 | 16.4,13 | 52.8 | 16.7,14 | 54.0 | 17.1' | split: ','
  endif
-%}

<dialog class="pdp-sheet" data-bottom-sheet data-sheet="size-guide" scroll-lock aria-labelledby="PdpSizeGuideTitle">
  <div class="pdp-sheet_panel">
    <div class="pdp-sheet_panel_head">
      <h2 class="pdp-sheet_panel_head_title" id="PdpSizeGuideTitle">{{ guide_title }}</h2>
      <button
        type="button"
        class="pdp-sheet_panel_head_close"
        data-sheet-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="pdp-sheet_panel_body">
      <div class="pdp-sheet_panel_body_group">
        <p class="pdp-sheet_panel_body_group_label">{{ measure_heading }}</p>
        {%- if measure_image != blank -%}
          {{
            measure_image
            | image_url: width: 806
            | image_tag:
              loading: 'lazy',
              widths: '403,806',
              sizes: '(min-width: 750px) 403px, calc(100vw - 32px)',
              alt: measure_heading,
              class: 'pdp-sheet_panel_body_guide-image'
          }}
        {%- endif -%}
      </div>

      <div class="pdp-sheet_panel_body_group">
        <p class="pdp-sheet_panel_body_group_label">{{ chart_heading }}</p>
        <div class="pdp-sheet_panel_body_table">
          <table class="pdp-table pdp-table--size-guide">
            <thead>
              <tr>
                {%- for column in columns -%}
                  <th scope="col">{{ column | strip }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in rows -%}
                {%- assign cells = row | split: '|' -%}
                <tr>
                  {%- for column in columns -%}
                    <td>{{ cells[forloop.index0] | strip }}</td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>

      {%- if whatsapp_url != blank -%}
        <a
          href="{{ whatsapp_url }}"
          class="pdp_button pdp_button--primary pdp_button--compact pdp-sheet_panel_body_cta"
          data-analytics="size_guide_whatsapp_click"
          target="_blank"
          rel="noopener"
        >
          <span class="pdp_button_icon pdp-sheet_panel_body_cta_icon" aria-hidden="true">
            {{- 'icon-whatsapp.svg' | inline_asset_content -}}
          </span>
          {{ cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</dialog>
