{%- doc -%}
  The empty drawer shell. Its contents are fetched per product through the
  Section Rendering API by variant-drawer.js. Figma 7930:102851.
{%- enddoc -%}

{%- comment -%}
  A popover so variant-drawer.js can lift it into the browser's top layer while
  open - above sticky bars and app widgets alike.
{%- endcomment -%}
<variant-drawer class="variant-drawer" popover="manual" hidden>
  <div class="variant-drawer_scrim" data-drawer-close></div>

  <div
    class="variant-drawer_panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="VariantDrawerTitle"
  >
    <div class="variant-drawer_panel_head">
      <h2
        class="variant-drawer_panel_head_title"
        id="VariantDrawerTitle"
        data-drawer-title
        data-list-title="{{ 'products.select_variants' | t | escape }}"
      >
        {{- 'products.select_variant' | t -}}
      </h2>
      <button
        type="button"
        class="variant-drawer_panel_head_close"
        data-drawer-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="variant-drawer_panel_content" data-drawer-content></div>

    {%- comment -%}
      Shown in the content while a product is fetched, laid out like the card
      and options that replace it, so nothing jumps when they land. The tiles
      come from skeleton.css.
    {%- endcomment -%}
    <template data-drawer-skeleton>
      <div class="variant-drawer_skeleton" aria-hidden="true">
        <div class="variant-drawer_skeleton_card">
          <span class="skeleton_tile variant-drawer_skeleton_card_media"></span>
          <div class="variant-drawer_skeleton_card_info">
            <span class="skeleton_tile variant-drawer_skeleton_line variant-drawer_skeleton_line--price"></span>
            <span class="skeleton_tile variant-drawer_skeleton_line variant-drawer_skeleton_line--title"></span>
          </div>
        </div>
        <span class="skeleton_tile variant-drawer_skeleton_line variant-drawer_skeleton_line--label"></span>
        <div class="variant-drawer_skeleton_values">
          {%- for value in (1..3) -%}
            <span class="skeleton_tile skeleton_tile--round variant-drawer_skeleton_value"></span>
          {%- endfor -%}
        </div>
        <span class="skeleton_tile variant-drawer_skeleton_line variant-drawer_skeleton_line--label"></span>
        <div class="variant-drawer_skeleton_values">
          {%- for value in (1..6) -%}
            <span class="skeleton_tile skeleton_tile--round variant-drawer_skeleton_value"></span>
          {%- endfor -%}
        </div>
      </div>
    </template>

    <div class="variant-drawer_panel_footer">
      <button
        type="button"
        class="variant-drawer_panel_footer_done"
        data-drawer-done
        data-label-done="{{ 'products.done' | t | escape }}"
        data-label-add="{{ 'products.add_to_cart' | t | escape }}"
        disabled
      >
        {{- 'products.done' | t -}}
      </button>
    </div>
  </div>
</variant-drawer>
