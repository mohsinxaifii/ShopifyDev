{%- doc -%}
  Opens the "Why you'll love it" accordion; the "Highlight" blocks placed
  after it in the editor fill it, and the section closes it after the last
  one. Echoed as strings because the elements are closed elsewhere.

  @param {object} [block] - the "Why you'll love it" block (left out when
    highlights appear without one: a default heading, open). Only rendered
    once a bullet with text follows.
{%- enddoc -%}

{%- liquid
  assign heading = block.settings.highlights_heading | default: 'Why you’ll love it' | escape
  assign is_open = true
  if block != blank and block.settings.open == false
    assign is_open = false
  endif
  echo '<details class="pdp_accordion" '
  echo block.shopify_attributes
  if is_open
    echo ' open'
  endif
  echo '><summary class="pdp_accordion_summary"><span>'
  echo heading
  echo '</span><span class="pdp_accordion_summary_sign" aria-hidden="true"><span class="pdp_accordion_summary_sign_plus">'
  echo 'icon-plus.svg' | inline_asset_content
  echo '</span><span class="pdp_accordion_summary_sign_minus">'
  echo 'icon-minus.svg' | inline_asset_content
  echo '</span></span></summary><div class="pdp_accordion_body"><ul class="pdp_highlights">'
-%}
