{%- doc -%}
  "You may also like" / "Recently viewed" tabs. Figma 7930:96277.
  You may also like: up to 10 pieces from the catalogue hierarchy within 20%
  of the product's price - same vertical, then same sub-category (see
  snippets/catalog-related). Nothing is linked by hand. Recently viewed is
  filled by product.js from the shopper's own history.
  Each tab shows only with something in it: with no "You may also like"
  cards the section starts hidden and product.js reveals it (Recently viewed
  only) when there is history; with neither, nothing shows.

  @param {object} product - the product being viewed
  @param {object} [block] - its block, for the theme editor
  @param {object} labels - the block's settings (tab names)
{%- enddoc -%}

{%- capture also_like -%}
  {%- render 'catalog-related', product: product, limit: 10 -%}
{%- endcapture -%}
{%- assign has_also_like = false -%}
{%- if also_like != blank -%}
  {%- assign has_also_like = true -%}
{%- endif -%}

<section
  class="pdp_related"
  data-related
  data-animate
  {{ block.shopify_attributes }}
  {% unless has_also_like %}
    hidden
  {% endunless %}
>
  <div class="pdp_related_tabs" role="tablist">
    {%- if has_also_like -%}
      <button
        type="button"
        class="pdp_related_tabs_tab is-active"
        role="tab"
        aria-selected="true"
        data-tab="also-like"
      >
        {{ labels.related_heading | default: 'You may also like' }}
      </button>
    {%- endif -%}
    <button
      type="button"
      class="pdp_related_tabs_tab{% unless has_also_like %} is-active{% endunless %}"
      role="tab"
      aria-selected="{% if has_also_like %}false{% else %}true{% endif %}"
      data-tab="recent"
      hidden
    >
      {{ labels.recent_heading | default: 'Recently viewed' }}
    </button>
  </div>

  {%- if has_also_like -%}
    <scroll-carousel class="pdp_related_panel" data-panel="also-like">
      <div class="pdp_related_panel_track" data-track data-animate-group data-animate-stagger="0.06">
        {{ also_like }}
      </div>
      <div class="pdp_related_panel_dots scroll-carousel_dots" data-dots></div>
    </scroll-carousel>
  {%- endif -%}

  <div class="pdp_related_panel" data-panel="recent"{% if has_also_like %} hidden{% endif %}>
    <div class="pdp_related_panel_track" data-recent-track></div>
  </div>
</section>
