{%- doc -%}
  Outputs the handles of a product's "Pair beautifully with" pieces, comma
  separated, for the PDP card and the UGC lightbox rail to look up with
  all_products.

  The list is `custom.pdp_pair_products`, a single-line text metafield of
  comma-separated product handles, e.g.
    golden-grace-chain-bracelet, lustrous-horizon-studs
  The variant is not part of it: a piece with options is picked in the variant
  drawer when the shopper selects it. Handles that match no product are
  skipped. Without the metafield, Shopify's complementary-product
  recommendations are used.

  @param {object} product - The product whose pairings to resolve
{%- enddoc -%}

{%- liquid
  assign handles = ''
  assign entries = product.metafields.custom.pdp_pair_products.value | split: ','

  for entry in entries
    assign entry_handle = entry | strip | downcase
    if entry_handle == blank
      continue
    endif
    if all_products[entry_handle].id != blank
      assign handles = handles | append: entry_handle | append: ','
    endif
  endfor

  if handles == ''
    assign shopify_recs = product.metafields['shopify--discovery--product_recommendation']
    for item in shopify_recs.complementary_products.value
      assign handles = handles | append: item.handle | append: ','
    endfor
  endif

  echo handles
-%}
