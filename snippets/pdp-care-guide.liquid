{%- doc -%}
  The Care guide accordion: one image, the same on every product, set in the
  product section. Nothing is rendered without an image.

  @param {string} [heading] - accordion title, defaults to "Care guide"
  @param {object} [image] - the care guide image
{%- enddoc -%}

{%- if image != blank -%}
  {%- assign care_heading = heading | default: 'Care guide' -%}
  <details class="pdp_accordion">
    <summary class="pdp_accordion_summary">
      <span>{{ care_heading }}</span>
      <span class="pdp_accordion_summary_sign" aria-hidden="true">
        <span class="pdp_accordion_summary_sign_plus">{{ 'icon-plus.svg' | inline_asset_content }}</span>
        <span class="pdp_accordion_summary_sign_minus">{{ 'icon-minus.svg' | inline_asset_content }}</span>
      </span>
    </summary>
    <div class="pdp_accordion_body">
      <span class="pdp_accordion_body_media">
        {{
          image
          | image_url: width: 1112
          | image_tag:
            loading: 'lazy',
            widths: '361,556,722,1112',
            sizes: '(max-width: 749px) calc(100vw - 32px), 556px',
            alt: care_heading
        }}
      </span>
    </div>
  </details>
{%- endif -%}
