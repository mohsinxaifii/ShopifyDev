{%- doc -%}
  Loading placeholder for the wishlist. Figma "Wishlist page skeleton"
  7930:94446.

  Unlike every other skeleton in the theme this one is not covering finished
  markup - the grid behind it is genuinely empty until wishlist.js has fetched
  the cards - so it sits in the flow rather than over the page, and wishlist.js
  removes it when the cards land. skeleton.css's timeout still applies, which
  matters here: if the script never runs the placeholder fades instead of
  sitting there forever.

  Four circles for the filters, then six card tiles on the four-up grid.
{%- enddoc -%}

<div class="wishlist-skeleton" data-skeleton aria-hidden="true">
  <div class="wishlist-skeleton_filters">
    {%- for chip in (1..4) -%}
      <div class="wishlist-skeleton_filters_item">
        <span class="skeleton_tile skeleton_tile--round wishlist-skeleton_filters_item_circle"></span>
        <span class="skeleton_tile" style="height: 17px; width: 52px"></span>
      </div>
    {%- endfor -%}
  </div>

  <div class="wishlist-skeleton_grid">
    {%- for card in (1..6) -%}
      <span class="skeleton_tile skeleton_tile--card wishlist-skeleton_grid_item"></span>
    {%- endfor -%}
  </div>
</div>
