{%- doc -%}
  The body of one product-details accordion (a `product_details` metaobject
  list). The care guide is the exception: when the product has a care guide
  image (custom.pdp_care_guide_image) that image is the whole guide, and the
  text rows are left out.

  @param {object} list - a product details list metaobject
  @param {object} product - a Shopify product object
{%- enddoc -%}

<div class="pdp_accordion_body">
  {%- comment -%}
    The care guide entry is shared by every product, so its image is a
    per-product upload. Without one the rows stay, so it never opens empty.
  {%- endcomment -%}
  {%- liquid
    assign care_image = blank
    assign list_heading = list.heading | downcase
    if list_heading contains 'care'
      assign care_image = product.metafields.custom.pdp_care_guide_image.value
    endif
  -%}
  {%- if care_image != blank -%}
    <span class="pdp_accordion_body_media">
      {{
        care_image
        | image_url: width: 1112
        | image_tag:
          loading: 'lazy',
          widths: '361,556,722,1112',
          sizes: '(max-width: 749px) calc(100vw - 32px), 556px',
          alt: list.heading
      }}
    </span>
  {%- else -%}
    <dl class="pdp_specs">
      {%- for item in list.product_details_item.value -%}
        <div class="pdp_specs_row">
          <dt class="pdp_specs_row_key">{{ item.title }}</dt>
          <dd class="pdp_specs_row_value">{{ item.content }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  {%- endif -%}
</div>
