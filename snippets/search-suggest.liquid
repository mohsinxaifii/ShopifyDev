{%- doc -%}
  The header's search field plus its suggestion panel. Figma states "Search
  active" (7930:105820), "Results found" (7930:106038) and "Results not found"
  (7930:106256).

  The panel ships empty: its contents come from Shopify's predictive search
  endpoint, which is the only source that can rank a partial query. The three
  Figma states are the panel's three shapes - no query, hits, no hits - rather
  than three separate components.
{%- enddoc -%}

<search-suggest class="search-suggest">
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="header_wrapper_search"
    data-suggest-form
  >
    <button type="submit" class="header_wrapper_search_icon" aria-label="{{ 'accessibility.search' | t }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </button>

    <input
      type="search"
      name="q"
      class="header_wrapper_search_input"
      placeholder="{{ 'search.placeholder_short' | t }}"
      autocomplete="off"
      value="{{ search.terms | escape }}"
      role="combobox"
      aria-expanded="false"
      aria-controls="SearchSuggestPanel"
      aria-autocomplete="list"
      data-suggest-input
    >

    <button
      type="button"
      class="search-suggest_clear"
      data-suggest-clear
      aria-label="{{ 'collection.clear_all' | t }}"
      hidden
    >
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <input type="hidden" name="type" value="product">
  </form>

  <div
    class="search-suggest_panel"
    id="SearchSuggestPanel"
    role="listbox"
    data-suggest-panel
    hidden
  ></div>

  {%- comment -%}
    Z-Now (Figma 8470:74266): the catalogue categories the ZNow collection
    has products in, each with its ZNow page (the collection narrowed by the
    category's tag, as its chips do - snippets/catalog-chips). search-suggest.js
    adds "Rings · Now · Get today" when the term names one, in the ZNow area.
  {%- endcomment -%}
  {%- liquid
    assign znow_handle = settings.znow_collection_handle | default: 'znow' | strip
    assign znow_collection = collections[znow_handle]
    assign znow_tags = '|'
    for znow_tag in znow_collection.all_tags
      assign znow_tag_handle = znow_tag | handleize
      assign znow_tags = znow_tags | append: znow_tag_handle | append: '|'
    endfor
  -%}
  {%- if znow_collection.products_count > 0 -%}
    <script type="application/json" data-suggest-znow>
      {
        "icon": {{ 'icon-znow-8.svg' | inline_asset_content | json }},
        "categories": [
          {%- assign first = true -%}
          {%- for category in metaobjects.catalog_category.values -%}
            {%- liquid
              assign category_tag = category.tag.value | default: category.name.value | handleize
              assign needle = '|' | append: category_tag | append: '|'
              unless znow_tags contains needle
                continue
              endunless
            -%}
            {%- unless first %},{% endunless -%}
            {"name": {{ category.name.value | json }}, "url": {{ znow_collection.url | append: '/' | append: category_tag | json }}}
            {%- assign first = false -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</search-suggest>
