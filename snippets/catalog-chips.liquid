{%- doc -%}
  The rail of chips above a collection's grid, from the catalogue hierarchy
  (see snippets/catalog-path): "All" for the page itself, then
  - a category: its sub-categories
  - a sub-category: its verticals
  - a vertical: nothing (the last level)
  - a collection outside the hierarchy (a campaign such as "Gifting"): the
    categories its products carry.

  Every chip narrows THIS collection by its entry's tag rather than opening
  the entry's own page - /collections/rings/daily-wear is Rings x Daily Wear -
  so the rail stays the same while the shopper moves between its chips, with
  the applied one highlighted ("All" when none is). A collection set as a
  category's own collection (a campaign "A" with its sub-categories linked)
  gets that category's sub-categories the same way.

  Linked entries always show; the outside-the-hierarchy categories show only
  when this collection has products carrying their tag.

  @param {string} path - this collection's path from catalog-path (empty when outside it)
  @param {object} collection - the collection being viewed
{%- enddoc -%}

{%- liquid
  assign handles = path | split: ','
  assign current_tag = current_tags.first | handleize
  assign only_present = false
  case handles.size
    when 0
      assign children = metaobjects.catalog_category.values
      assign only_present = true
      assign collection_tags = '|'
      for collection_tag in collection.all_tags
        assign collection_tags = collection_tags | append: collection_tag | handleize | append: '|'
      endfor
    when 1
      assign children = metaobjects.catalog_category[handles[0]].subcategories.value
    when 2
      assign children = metaobjects.catalog_subcategory[handles[1]].verticals.value
    else
      assign children = blank
  endcase
-%}

{%- capture child_chips -%}
  {%- assign position = 1 -%}
  {%- for child in children -%}
    {%- liquid
      assign child_tag = child.tag.value | default: child.name.value | handleize
      if only_present
        assign needle = '|' | append: child_tag | append: '|'
        unless collection_tags contains needle
          continue
        endunless
      endif
      assign child_url = collection.url | append: '/' | append: child_tag
      assign child_active = false
      if child_tag == current_tag
        assign child_active = true
      endif
      assign position = position | plus: 1
    -%}
    <a
      href="{{ child_url }}"
      class="collection_wrapper_main_chips_chip{% if child_active %} is-active{% endif %}"
      data-analytics="plp_chip_click"
      data-analytics-chip-name="{{ child.name.value | escape }}"
      data-analytics-collection-name="{{ collection.title | escape }}"
      data-analytics-position="{{ position }}"
      {% if child_active %}
        aria-current="page"
      {% endif %}
    >
      {{- child.name.value -}}
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- if child_chips != blank -%}
  <nav class="collection_wrapper_main_chips" aria-label="{{ 'collection.filters' | t }}">
    <a
      href="{{ collection.url }}"
      class="collection_wrapper_main_chips_chip{% if current_tags == blank %} is-active{% endif %}"
      data-analytics="plp_chip_click"
      data-analytics-chip-name="All"
      data-analytics-collection-name="{{ collection.title | escape }}"
      data-analytics-position="1"
      {% if current_tags == blank %}
        aria-current="page"
      {% endif %}
    >
      All
    </a>
    {{- child_chips -}}
  </nav>
{%- endif -%}
