{%- doc -%}
  Shopper location - loads assets/location.js, which asks the browser for the
  shopper's location once (its own permission prompt, on the first page of the
  first visit) to get the delivery pincode ZNow and the delivery estimates
  read. Theme settings > Location & ZNow.

  ZNow area: assets/znow-area.json (the outline a location fix is tested
  against) and snippets/znow-pincodes (the pincodes a typed pincode is
  tested against).

  Rendered first in the body: the inline script below marks <html> with
  "is-znow" from what was saved on an earlier page, before the header is
  parsed, so ZNow pieces never flash in or out. Anything ZNow-only hides with
  `html:not(.is-znow) ...`; location.js keeps the class in step.
{%- enddoc -%}

{%- capture znow_pincodes -%}{% render 'znow-pincodes' %}{%- endcapture -%}
{%- assign znow_pincodes = znow_pincodes | replace: ',', ' ' | split: ' ' | uniq -%}

<script>
  window.zinaraLocationConfig = {
    enabled: {{ settings.location_prompt_enabled | json }},
    pageType: {{ request.page_type | json }},
    znowPincodes: {{ znow_pincodes | json }},
    znowAreaUrl: {{ 'znow-area.json' | asset_url | json }},
    {%- comment -%} The theme editor always shows the ZNow pieces, to edit them. {%- endcomment -%}
    znowPreview: {{ request.design_mode | json }},
  };
  (function () {
    var config = window.zinaraLocationConfig;
    var saved = null;
    try {
      saved = JSON.parse(localStorage.getItem('zinara_location'));
    } catch (error) {}
    if (!saved) {
      try {
        var match = document.cookie.match(/(?:^|; )zinara_location=([^;]*)/);
        saved = match && JSON.parse(decodeURIComponent(match[1]));
      } catch (error) {}
    }
    saved = saved || {};
    // As znowNow() in location.js: a location fix decides by the area, a typed pincode by the list.
    var znow = saved.source === 'gps' && typeof saved.inZnowArea === 'boolean'
      ? saved.inZnowArea
      : config.znowPincodes.indexOf(saved.pincode || '') !== -1;
    if (config.znowPreview || znow) {
      document.documentElement.classList.add('is-znow');
    }
  })();
</script>
<script src="{{ 'location.js' | asset_url }}" defer="defer"></script>
