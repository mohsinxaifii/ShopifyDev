{%- comment -%}
  Star row for a review. Figma: five 16px stars on a 3.56px gap, #D38A0D filled.
  Accepts: rating (1-5)
{%- endcomment -%}
<span class="testimonial-stars" aria-label="{{ rating | default: 5 }} out of 5 stars">
  {%- for i in (1..5) -%}
    <span class="testimonial-stars_star{% if i > rating %} is-empty{% endif %}">
      {{- 'icon-star.svg' | inline_asset_content -}}
    </span>
  {%- endfor -%}
</span>
