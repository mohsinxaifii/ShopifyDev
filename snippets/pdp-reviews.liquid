{%- doc -%}
  Customer reviews. Figma 7930:96415. Summary and reviews come only from
  Judge.me (judgeme.js); "Write a review" opens the in-theme form when the
  section has a review endpoint, else follows the review link.

  @param {object} product - the product being viewed
  @param {object} [block] - its block, for the theme editor
  @param {object} labels - the product section's settings (heading, button labels, endpoint)
{%- enddoc -%}

<section class="pdp_reviews" id="pdp-reviews" data-animate {{ block.shopify_attributes }}>
  <div class="pdp_reviews_head">
    <h2 class="pdp_section_title">{{ labels.reviews_heading | default: 'Customer reviews' }}</h2>
    {%- comment -%}
      With a review endpoint set, the button opens the in-theme review
      form (pdp-review-sheet); without one it falls back to the link.
    {%- endcomment -%}
    {%- if labels.review_endpoint != blank -%}
      <button
        type="button"
        class="pdp_button pdp_button--primary pdp_button--compact"
        data-open="review"
        data-analytics="review_interaction"
        data-analytics-action="write_review_click"
      >
        {{ labels.write_review_label | default: 'Write a review' }}
      </button>
    {%- elsif labels.review_url != blank -%}
      <a
        href="{{ labels.review_url }}"
        class="pdp_button pdp_button--primary pdp_button--compact"
        data-analytics="review_interaction"
        data-analytics-action="write_review_click"
      >
        {{ labels.write_review_label | default: 'Write a review' }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    Summary and reviews come only from Judge.me: judgeme.js fills them in
    and fetches the next page for "Show more". Each part stays hidden
    until Judge.me has something to show.
  {%- endcomment -%}
  <judgeme-reviews data-handle="{{ product.handle }}" data-per-page="{{ labels.reviews_shown }}">
    <div class="pdp_reviews_summary" data-reviews-summary hidden>
      <span class="pdp_reviews_summary_score" data-reviews-score></span>
      <span class="pdp_reviews_summary_rule" aria-hidden="true"></span>
      {%- render 'testimonial-stars', rating: 5 -%}
      <span class="pdp_reviews_summary_count" data-reviews-count></span>
    </div>

    <ul class="pdp_reviews_list" data-reviews-list hidden></ul>

    <template data-review-template>
      <li class="pdp_reviews_list_item">
        {%- render 'testimonial-stars', rating: 5 -%}

        <p class="pdp_reviews_list_item_author">
          <span class="pdp_reviews_list_item_author_name" data-review-author></span>
          <span class="pdp_reviews_list_item_author_dot" aria-hidden="true" data-review-verified hidden></span>
          <span class="pdp_reviews_list_item_author_badge" data-review-verified hidden>{{ labels.verified_label | default: 'Verified buyer' }}</span>
        </p>

        <div class="pdp_reviews_list_item_media" data-review-media hidden></div>

        <p class="pdp_reviews_list_item_body" data-review-body></p>
        <p class="pdp_reviews_list_item_date" data-review-date hidden></p>
      </li>
    </template>

    <div class="pdp_reviews_more" data-reviews-more hidden>
      <button type="button" class="pdp_button pdp_button--outline pdp_button--compact">
        {{ labels.show_more_reviews_label | default: 'Show more reviews' }}
      </button>
    </div>
  </judgeme-reviews>
</section>
