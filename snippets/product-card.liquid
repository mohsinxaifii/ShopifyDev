{%- doc -%}
  Renders one product card.

  Two shapes, from the same data:
  - carousel (default) - square media, wishlist pinned in the media corner, and
    a compact price/title block. Used by the product carousels on the home page.
  - grid - the PLP card (Figma 7930:101972). Same media, but the wishlist moves
    down beside the price and an add-to-cart button closes the card.

  @param {object} product - a Shopify product object
  @param {string} [variant] - 'carousel' (default) or 'grid'
{%- enddoc -%}

{%- liquid
  assign card_variant = variant | default: 'carousel'
  assign is_grid = false
  if card_variant == 'grid'
    assign is_grid = true
  endif

  assign feature_badge = product.metafields.custom.product_card_badges.first
  assign is_price_drop = false
  assign is_ready_to_ship = false
  if product.compare_at_price > product.price
    assign is_price_drop = true
  endif

  comment
    "Ready to ship" speaks for the variant the card opens on, not any variant:
    a product whose only stock is in another size would otherwise promise a
    page that lands on a made-to-order or sold-out variant.
  endcomment
  assign card_default_variant = product.selected_or_first_available_variant
  if card_default_variant.available and card_default_variant.inventory_quantity > 0
    assign is_ready_to_ship = true
  endif

  assign card_image_alt = product.featured_image.alt | default: product.title

  comment
    This shop formats money as a bare "{{amount}}", but the designs show the
    currency symbol, so prepend it unless the format already carries one.
  endcomment
  assign money_symbol = cart.currency.symbol
  assign price_text = product.price | money_without_trailing_zeros
  unless price_text contains money_symbol
    assign price_text = price_text | prepend: money_symbol
  endunless
  assign compare_text = product.compare_at_price | money_without_trailing_zeros
  unless compare_text contains money_symbol
    assign compare_text = compare_text | prepend: money_symbol
  endunless

  comment
    The grid card is not a fixed 266px: it is a third of the results column on
    desktop (wider than 266px on big screens), half the screen on tablets and
    the full width below 600px (collection.css). `sizes` follows that so phones
    don't stretch a 266px-wide file across a ~360px card.
  endcomment
  if is_grid
    assign media_sizes = '(min-width: 990px) 340px, (min-width: 600px) calc(50vw - 40px), calc(100vw - 32px)'
    assign media_widths = '266,360,533,720,940,1080'
    assign media_src_width = 1080
  else
    assign media_sizes = '240px'
    assign media_widths = '240,360,480'
    assign media_src_width = 540
  endif
-%}

{%- capture analytics_item -%}{%- render 'analytics-item', product: product -%}{%- endcapture -%}
<a
  href="{{ product.url }}"
  class="product-card{% if is_grid %} product-card--grid{% endif %}"
  data-analytics-item="{{ analytics_item | strip_newlines | escape }}"
  {% if is_grid %}
    data-animate
    data-animate-distance="20"
  {% endif %}
>
  <span class="product-card_media">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: media_src_width
        | image_tag:
          loading: 'lazy',
          widths: media_widths,
          sizes: media_sizes,
          alt: card_image_alt,
          class: 'product-card_media_image'
      }}
    {%- endif -%}

    <span class="product-card_media_top">
      {%- if is_ready_to_ship -%}
        <span class="product-card_media_top_badge product-card_media_top_badge--ready">Ready to ship</span>
      {%- elsif is_price_drop -%}
        <span class="product-card_media_top_badge product-card_media_top_badge--price-drop">Price drop</span>
      {%- elsif feature_badge != blank -%}
        <span class="product-card_media_top_badge product-card_media_top_badge--feature">{{ feature_badge }}</span>
      {%- else -%}
        <span></span>
      {%- endif -%}

      {%- unless is_grid -%}
        <button
          type="button"
          class="product-card_media_top_wishlist"
          data-wishlist-toggle
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          aria-label="{{ 'accessibility.wishlist_add' | t }}"
          aria-pressed="false"
        >
          {%- render 'wishlist-heart' -%}
        </button>
      {%- endunless -%}
    </span>

    {%- comment -%} Filled from Judge.me by judgeme.js; stays hidden until it has reviews. {%- endcomment -%}
    <judgeme-rating data-handle="{{ product.handle }}" hidden>
      <span class="product-card_media_rating">
        {{ 'icon-star.svg' | inline_asset_content }}
        <span class="product-card_media_rating_value" data-judgeme-value></span>
      </span>
    </judgeme-rating>
  </span>

  <span class="product-card_info">
    <span class="product-card_info_price">
      <span class="product-card_info_price_current">{{ price_text }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card_info_price_compare">{{ compare_text }}</span>
      {%- endif -%}

      {%- if is_grid -%}
        <button
          type="button"
          class="product-card_info_price_wishlist"
          data-wishlist-toggle
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          aria-label="{{ 'accessibility.wishlist_add' | t }}"
          aria-pressed="false"
        >
          {%- render 'wishlist-heart' -%}
        </button>
      {%- endif -%}
    </span>
    <span class="product-card_info_title">{{ product.title }}</span>

    {%- if is_grid -%}
      {%- liquid
        assign card_variant_id = product.selected_or_first_available_variant.id
        assign can_add = product.available
      -%}
      {%- if can_add -%}
        <button
          type="button"
          class="product-card_info_add"
          data-add-to-cart
          data-variant-id="{{ card_variant_id }}"
          data-variant-count="{{ product.variants.size }}"
          data-product-url="{{ product.url }}"
          data-product-id="{{ product.id }}"
          data-added-label="{{ 'products.added_to_cart' | t | escape }}"
        >
          <span class="product-card_info_add_icon product-card_info_add_icon--bag" aria-hidden="true">
            {{- 'icon-shopping-bag.svg' | inline_asset_content -}}
          </span>
          <span class="product-card_info_add_icon product-card_info_add_icon--check" aria-hidden="true">
            {{- 'icon-check.svg' | inline_asset_content -}}
          </span>
          <span class="product-card_info_add_label" data-add-label>{{ 'products.add_to_cart' | t }}</span>
        </button>
      {%- else -%}
        <span class="product-card_info_add product-card_info_add--disabled">
          <span class="product-card_info_add_label">{{ 'products.sold_out' | t }}</span>
        </span>
      {%- endif -%}
    {%- endif -%}
  </span>
</a>
