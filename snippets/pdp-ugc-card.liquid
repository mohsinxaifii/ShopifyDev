{%- doc -%}
  One shoppable card in the UGC lightbox rail. Figma 7930:101840 - a wide card
  with the thumbnail on the left and price, title and an add button stacked on
  the right.

  @param {object} item - a Shopify product object
  @param {object} [variant] - the variant to show and add; defaults to the
    product's selected or first available one
  @param {string} [pinned] - '1' when the variant was named outright, so it is
    added as-is rather than picked in the variant drawer
{%- enddoc -%}

{%- liquid
  assign variant = variant | default: item.selected_or_first_available_variant
  assign variant_count = item.variants.size
  if pinned == '1'
    assign variant_count = 1
  endif
  assign item_image = variant.featured_image | default: item.featured_image
-%}

<article class="pdp-ugc-card">
  <a href="{{ variant.url }}" class="pdp-ugc-card_media">
    {%- if item_image -%}
      {{
        item_image
        | image_url: width: 176
        | image_tag: loading: 'lazy', widths: '88,176', sizes: '88px', alt: item.title
      }}
    {%- endif -%}
  </a>

  <div class="pdp-ugc-card_info">
    <span class="pdp-ugc-card_info_price">
      <span class="pdp-ugc-card_info_price_current">{%- render 'money', amount: variant.price -%}</span>
      {%- if variant.compare_at_price > variant.price -%}
        <span class="pdp-ugc-card_info_price_compare">
          {%- render 'money', amount: variant.compare_at_price -%}
        </span>
      {%- endif -%}
    </span>

    <a href="{{ variant.url }}" class="pdp-ugc-card_info_title">{{ item.title }}</a>

    <button
      type="button"
      class="pdp_button pdp_button--primary pdp_button--compact pdp-ugc-card_info_add"
      data-add-single
      data-variant-id="{{ variant.id }}"
      data-variant-count="{{ variant_count }}"
      data-product-url="{{ item.url }}"
      data-added-label="{{ 'products.added_to_cart' | t | escape }}"
    >
      <span class="pdp_button_icon" aria-hidden="true">
        {{- 'icon-shopping-bag.svg' | inline_asset_content -}}
      </span>
      <span data-add-single-label>{{ 'products.add_to_cart' | t }}</span>
    </button>
  </div>
</article>
