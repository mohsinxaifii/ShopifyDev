{%- doc -%}
  Add-ons sidesheet. Figma 7930:100360.

  Each card toggles a selection rather than adding straight to the cart, so the
  shopper can pick several and commit once with Done - which is also what keeps
  the add-ons in the same cart request as the main product. As with "Pair
  beautifully with", there is no variant picking: an add-on goes in as its
  first available variant, and one with nothing available cannot be ticked.

  The hero above the grid follows the selection: each `pdp_addon_preview`
  entry pairs a combination of add-on products with an image, and product.js
  shows the one matching what is ticked (exactly, or else the largest preview
  wholly inside the selection), falling back to the default hero.

  @param {object} addons - add-on products, from the add-on set or `custom.addons_products`
  @param {object} [hero] - default banner image above the grid
  @param {object} [previews] - `pdp_addon_preview` entries from the add-on set
  @param {object} labels - the product section's settings (title, intro, Done)
{%- enddoc -%}

<dialog class="pdp-sheet" data-bottom-sheet data-sheet="addons" scroll-lock aria-labelledby="PdpAddonsTitle">
  <div class="pdp-sheet_panel">
    <div class="pdp-sheet_panel_head">
      <h2 class="pdp-sheet_panel_head_title" id="PdpAddonsTitle">{{ labels.addons_sheet_title | default: 'Add ons' }}</h2>
      <button
        type="button"
        class="pdp-sheet_panel_head_close"
        data-sheet-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="pdp-sheet_panel_body pdp-sheet_panel_body--padded">
      <div class="pdp-sheet_panel_body_group">
        <p class="pdp-sheet_panel_body_group_label">{{ labels.addons_sheet_intro | default: 'Elevate your piece with curated add-ons' }}</p>
        {%- if hero != blank or previews != blank -%}
          <span class="pdp-addons_hero" data-addon-hero>
            {%- if hero != blank -%}
              {{
                hero
                | image_url: width: 806
                | image_tag:
                  loading: 'lazy',
                  widths: '403,806',
                  sizes: '(max-width: 749px) calc(100vw - 32px), 403px',
                  alt: '',
                  class: 'pdp-addons_hero_image is-active',
                  data-addon-preview: 'default'
              }}
            {%- endif -%}
            {%- for preview in previews -%}
              {%- assign preview_image = preview.image.value -%}
              {%- if preview_image != blank -%}
                {%- capture preview_ids -%}
                  {%- for item in preview.addons.value -%}{{ item.id }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
                {%- endcapture -%}
                {{
                  preview_image
                  | image_url: width: 806
                  | image_tag:
                    loading: 'lazy',
                    widths: '403,806',
                    sizes: '(max-width: 749px) calc(100vw - 32px), 403px',
                    alt: '',
                    class: 'pdp-addons_hero_image',
                    data-addon-preview: preview_ids
                }}
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </div>

      <ul class="pdp-addons_grid">
        {%- for addon in addons -%}
          {%- assign addon_variant = addon.first_available_variant -%}
          <li class="pdp-addons_grid_card">
            <span class="pdp-addons_grid_card_media">
              {%- if addon.featured_image -%}
                {{
                  addon.featured_image
                  | image_url: width: 344
                  | image_tag: loading: 'lazy', widths: '172,344', sizes: '172px', alt: addon.title
                }}
              {%- endif -%}
            </span>

            <button
              type="button"
              class="pdp-addons_grid_card_toggle"
              data-addon-toggle
              data-variant-id="{{ addon_variant.id }}"
              data-product-id="{{ addon.id }}"
              data-addon-name="{{ addon.title | escape }}"
              data-addon-price="{{ addon_variant.price | divided_by: 100.0 }}"
              aria-pressed="false"
              aria-label="Add {{ addon.title | escape }}"
              {% if addon_variant == blank %}
                disabled
              {% endif %}
            >
              <span class="pdp-addons_grid_card_toggle_plus" aria-hidden="true">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
              <span class="pdp-addons_grid_card_toggle_tick" aria-hidden="true">
                {{- 'icon-tick.svg' | inline_asset_content -}}
              </span>
            </button>

            <span class="pdp-addons_grid_card_title">{{ addon.title }}</span>
            <span class="pdp-addons_grid_card_price">+{% render 'money', amount: addon.price %}</span>
          </li>
        {%- endfor -%}
      </ul>

    </div>

    <div class="pdp-sheet_panel_footer">
      <button type="button" class="pdp_button pdp_button--primary pdp_button--compact" data-addons-done>
        {{- labels.addons_done_label | default: 'Done' -}}
      </button>
    </div>
  </div>
</dialog>
