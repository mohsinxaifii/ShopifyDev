{%- doc -%}
  "The Zinara Difference" comparison table. Figma 7930:96294. One row per
  "Difference row" block of the product section.

  @param {object} rows - the section's difference blocks
  @param {object} labels - the product section's settings (heading, column names, SGL logo)
{%- enddoc -%}

{%- comment -%}
  The heading mixes two colours mid-sentence ("The *Zinara* Difference"),
  so the accented run is marked with [brackets] in the setting and swapped
  for a span here - a second text setting would let the two halves drift
  apart in the editor.
{%- endcomment -%}
{%- assign heading_html = labels.difference_heading
  | replace: '[', '<span class="pdp_difference_title_accent">'
  | replace: ']', '</span>'
-%}
<section class="pdp_difference" data-animate data-animate-from="scale">
  <h2 class="pdp_difference_title">{{ heading_html }}</h2>
  <table class="pdp_difference_table">
    <thead>
      <tr>
        <th scope="col">{{ labels.difference_col_feature | default: 'Feature' }}</th>
        <th scope="col">{{ labels.difference_col_ours | default: 'Zinara' }}</th>
        <th scope="col">{{ labels.difference_col_others | default: 'Typical Brands' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in rows -%}
        <tr {{ block.shopify_attributes }}>
          <th scope="row">{{ block.settings.label }}</th>
          <td>
            <span class="pdp_difference_table_yes" aria-label="Yes">
              {{- 'icon-seal-check.svg' | inline_asset_content -}}
              {%- if block.settings.show_sgl and labels.sgl_logo != blank -%}
                {{ labels.sgl_logo | image_url: width: 76 | image_tag: loading: 'lazy', alt: 'SGL' }}
              {%- endif -%}
            </span>
          </td>
          <td>
            <span class="pdp_difference_table_no" aria-label="No">
              {{- 'icon-x-circle.svg' | inline_asset_content -}}
            </span>
          </td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</section>
