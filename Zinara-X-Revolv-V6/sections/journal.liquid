{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = blogs[section.settings.blog]
-%}

{%- if blog and blog.articles.size > 0 -%}
  <scroll-carousel class="journal full-width">
    <div class="journal_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="journal_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="journal_wrapper_stage">
        <div class="journal_wrapper_stage_track" data-track data-animate>
          {%- for article in blog.articles limit: section.settings.articles_to_show -%}
            <div class="journal_wrapper_stage_track_item">
              {%- if forloop.first -%}
                <span class="journal_wrapper_stage_track_item_tag">FEATURED</span>
              {%- endif -%}

              <a href="{{ article.url }}" class="journal_wrapper_stage_track_item_card">
                <span class="journal_wrapper_stage_track_item_card_image">
                  {%- if article.image -%}
                    {{
                      article.image
                      | image_url: width: 640
                      | image_tag: loading: 'lazy', widths: '316,474,632', sizes: '316px', alt: article.title
                    }}
                  {%- endif -%}
                </span>

                <span class="journal_wrapper_stage_track_item_card_body">
                  <span class="journal_wrapper_stage_track_item_card_body_date">
                    {{- article.published_at | date: '%-d %B, %Y' -}}
                  </span>

                  <span class="journal_wrapper_stage_track_item_card_body_text">
                    <span class="journal_wrapper_stage_track_item_card_body_text_title">{{ article.title }}</span>
                    <span class="journal_wrapper_stage_track_item_card_body_text_excerpt">
                      {{- article.excerpt_or_content | strip_html | truncate: 110 -}}
                    </span>
                  </span>

                  <span class="journal_wrapper_stage_track_item_card_body_readmore">
                    {{ 'accessibility.read_more' | t }}
                    {{ 'icon-caret-right.svg' | inline_asset_content }}
                  </span>
                </span>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>
  </scroll-carousel>

  <script src="{{ 'carousel-scroll.js' | asset_url }}" defer="defer"></script>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "class": "shopify-section--journal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The jewellery journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
