{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'testimonial-carousel.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <scroll-carousel class="testimonial-carousel full-width" loop>
    <div class="testimonial-carousel_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonial-carousel_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="testimonial-carousel_wrapper_stage">
        <div class="testimonial-carousel_wrapper_track" data-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              if product != blank
                assign product_title = product.title
                assign product_url = product.url
              else
                assign product_title = block.settings.product_title
                assign product_url = block.settings.product_url
              endif
            -%}

            <review-modal class="testimonial-carousel_wrapper_track_card" {{ block.shopify_attributes }}>
              <div class="testimonial-carousel_wrapper_track_card_row">
                <span class="testimonial-carousel_wrapper_track_card_row_image">
                  {%- if block.settings.image -%}
                    {{
                      block.settings.image
                      | image_url: width: 260
                      | image_tag: loading: 'lazy', widths: '126,190,260', sizes: '126px', alt: block.settings.name
                    }}
                  {%- endif -%}
                </span>

                <div class="testimonial-carousel_wrapper_track_card_row_content">
                  {%- render 'testimonial-stars', rating: block.settings.rating -%}

                  <p class="testimonial-carousel_wrapper_track_card_row_content_name">{{ block.settings.name }}</p>

                  <div class="testimonial-carousel_wrapper_track_card_row_content_quote">
                    <p class="testimonial-carousel_wrapper_track_card_row_content_quote_text">
                      {{- block.settings.quote -}}
                    </p>

                    <button
                      type="button"
                      class="testimonial-carousel_wrapper_track_card_row_content_quote_more"
                      data-review-open
                    >
                      {{- 'accessibility.read_more' | t -}}
                    </button>
                  </div>

                  {%- if product_title != blank -%}
                    {%- if product_url != blank -%}
                      <a
                        href="{{ product_url }}"
                        class="testimonial-carousel_wrapper_track_card_row_content_product"
                      >
                        {{- product_title -}}
                      </a>
                    {%- else -%}
                      <span class="testimonial-carousel_wrapper_track_card_row_content_product">
                        {{- product_title -}}
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>

              <dialog class="review-dialog" scroll-lock aria-label="{{ 'accessibility.review' | t }}">
                <div class="review-dialog_panel">
                  <div class="review-dialog_panel_head">
                    <p class="review-dialog_panel_head_title">{{ 'accessibility.review' | t }}</p>
                    <button
                      type="button"
                      class="review-dialog_panel_head_close"
                      data-review-close
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{ 'icon-close.svg' | inline_asset_content }}
                    </button>
                  </div>

                  <div class="review-dialog_panel_body">
                    <span class="review-dialog_panel_body_image">
                      {%- if block.settings.image -%}
                        {{
                          block.settings.image
                          | image_url: width: 320
                          | image_tag: loading: 'lazy', widths: '160,240,320', sizes: '160px', alt: block.settings.name
                        }}
                      {%- endif -%}
                    </span>

                    <div class="review-dialog_panel_body_content">
                      {%- render 'testimonial-stars', rating: block.settings.rating -%}

                      <p class="testimonial-carousel_wrapper_track_card_row_content_name">{{ block.settings.name }}</p>

                      <p class="review-dialog_panel_body_content_quote">{{ block.settings.quote }}</p>

                      {%- if product_title != blank -%}
                        {%- if product_url != blank -%}
                          <a
                            href="{{ product_url }}"
                            class="testimonial-carousel_wrapper_track_card_row_content_product"
                          >
                            {{- product_title -}}
                          </a>
                        {%- else -%}
                          <span class="testimonial-carousel_wrapper_track_card_row_content_product">
                            {{- product_title -}}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </dialog>
            </review-modal>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="scroll-carousel_arrow testimonial-carousel_wrapper_stage_prev"
          data-prev
          aria-label="{{ 'accessibility.previous_page' | t }}"
        >
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>

        <button
          type="button"
          class="scroll-carousel_arrow testimonial-carousel_wrapper_stage_next"
          data-next
          aria-label="{{ 'accessibility.next_page' | t }}"
        >
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>
  </scroll-carousel>

  <script src="{{ 'carousel-scroll.js' | asset_url }}" defer="defer"></script>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'review-modal.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section--testimonial-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "They tried it. They loved it!"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Trimmed to four lines on the card; the full text shows in the pop-up."
        },
        { "type": "header", "content": "Product mentioned" },
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product name (fallback)",
          "info": "Used only when no product is picked above."
        },
        { "type": "url", "id": "product_url", "label": "Product link (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
