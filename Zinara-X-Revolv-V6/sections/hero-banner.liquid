{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    The band takes its shape from the slides rather than a fixed 1280/576 box,
    so no image is ever cropped. With several slides it uses the tallest one
    (the smallest width/height ratio): every other slide then fits inside that
    box with object-fit: contain, instead of being trimmed to match it.
  endcomment
  assign hero_ratio = 0
  for block in section.blocks
    if block.settings.image
      assign slide_ratio = block.settings.image.aspect_ratio | plus: 0
      if slide_ratio > 0
        if hero_ratio == 0 or slide_ratio < hero_ratio
          assign hero_ratio = slide_ratio
        endif
      endif
    endif
  endfor
  if hero_ratio == 0
    assign hero_ratio = 2.2222
  endif

  comment
    Phones use each slide's mobile image when it has one (Figma Mobile
    7930:106698 is a 393x244 crop), so the band takes a second ratio from those.
  endcomment
  assign hero_ratio_mobile = 0
  for block in section.blocks
    assign slide_mobile_image = block.settings.mobile_image | default: block.settings.image
    if slide_mobile_image
      assign slide_ratio = slide_mobile_image.aspect_ratio | plus: 0
      if slide_ratio > 0
        if hero_ratio_mobile == 0 or slide_ratio < hero_ratio_mobile
          assign hero_ratio_mobile = slide_ratio
        endif
      endif
    endif
  endfor
  if hero_ratio_mobile == 0
    assign hero_ratio_mobile = hero_ratio
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <hero-banner-slideshow
    class="hero-banner full-width skeleton-host"
    style="--hero-ratio: {{ hero_ratio }}; --hero-ratio-mobile: {{ hero_ratio_mobile }};"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    {%- render 'hero-skeleton' -%}

    <div class="hero-banner_wrapper">
      <div class="hero-banner_wrapper_track">
        {%- for block in section.blocks -%}
          <div
            class="hero-banner_wrapper_track_slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              if forloop.first
                assign slide_loading = 'eager'
                assign slide_fetchpriority = 'high'
              else
                assign slide_loading = 'lazy'
                assign slide_fetchpriority = 'auto'
              endif

              assign slide_alt = block.settings.image.alt | default: block.settings.heading
              assign slide_alt = slide_alt | default: shop.name
            -%}
            {%- if block.settings.image -%}
              <picture class="hero-banner_wrapper_track_slide_picture">
                {%- if block.settings.mobile_image -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                      {{ block.settings.mobile_image | image_url: width: 800 }} 800w,
                      {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_fetchpriority,
                    widths: '750,1100,1500,2000',
                    sizes: '100vw',
                    class: 'hero-banner_wrapper_track_slide_image',
                    alt: slide_alt
                }}
              </picture>
            {%- endif -%}

            {%- if block.settings.heading != blank
              or block.settings.subheading != blank
              or block.settings.button_label != blank
            -%}
              <div class="hero-banner_wrapper_track_slide_content">
                {%- if block.settings.heading != blank -%}
                  <h2 class="hero-banner_wrapper_track_slide_content_heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="hero-banner_wrapper_track_slide_content_subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a
                    href="{{ block.settings.button_url | default: '#' }}"
                    class="hero-banner_wrapper_track_slide_content_button"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button type="button" class="hero-banner_wrapper_prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>
        <button type="button" class="hero-banner_wrapper_next" aria-label="{{ 'accessibility.next_slide' | t }}">
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>

        <div class="hero-banner_wrapper_dots" role="tablist" aria-label="{{ 'accessibility.slides' | t }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hero-banner_wrapper_dots_dot{% if forloop.first %} is-active{% endif %}"
              data-dot-index="{{ forloop.index0 }}"
              role="tab"
              aria-label="{{ 'accessibility.go_to_slide' | t: number: forloop.index }}"
              aria-selected="{{ forloop.first }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </hero-banner-slideshow>

  <script src="{{ 'hero-banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "shopify-section--hero-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Shown on phones instead of the image above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/zinara-hero-slide-1.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
