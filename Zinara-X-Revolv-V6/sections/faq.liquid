{{ 'faq.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section class="faq full-width">
    <div class="faq_wrapper">
      {%- if section.settings.heading != blank -%}
        {%- liquid
          assign heading_words = section.settings.heading | split: ' '
          assign accent_word = heading_words | last
          assign lead_length = heading_words.size | minus: 1
          assign lead_words = heading_words | slice: 0, lead_length
        -%}
        <h2 class="faq_wrapper_heading" data-animate>
          {%- if lead_length > 0 -%}{{ lead_words | join: ' ' }} {% endif -%}
          <span class="faq_wrapper_heading_accent">{{ accent_word }}</span>
        </h2>
      {%- endif -%}

      <div class="faq_wrapper_list" data-animate>
        {%- for block in section.blocks -%}
          <details
            class="faq_wrapper_list_item"
            name="faq-group-{{ section.id }}"
            {% if forloop.first %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faq_wrapper_list_item_summary">
              <span class="faq_wrapper_list_item_summary_question">{{ block.settings.question }}</span>
              <span class="faq_wrapper_list_item_summary_icon">
                <span class="faq_wrapper_list_item_summary_icon_plus">
                  {{- 'icon-faq-plus.svg' | inline_asset_content -}}
                </span>
                <span class="faq_wrapper_list_item_summary_icon_minus">
                  {{- 'icon-faq-minus.svg' | inline_asset_content -}}
                </span>
              </span>
            </summary>
            <div class="faq_wrapper_list_item_answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script src="{{ 'faq.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section--faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are lab grown diamonds real?",
            "answer": "Lab grown diamonds appear identical to natural diamonds and can't be distinguished by the naked eye and with standard microscopic tools. Trained jewellers and experts can't also tell the difference between them. They can only be distinguished from natural diamonds using specialized equipment that can detect the specific growth patterns and inclusions characteristic of their origin."
          }
        },
        {
          "type": "question",
          "settings": { "question": "Can you tell the difference between lab grown diamonds and natural diamonds?" }
        },
        { "type": "question", "settings": { "question": "Are ZINARA lab grown diamonds graded and certified?" } },
        { "type": "question", "settings": { "question": "Do you deliver pan India?" } },
        { "type": "question", "settings": { "question": "Is ID proof required for delivery?" } },
        { "type": "question", "settings": { "question": "What payment options are available?" } }
      ]
    }
  ]
}
{% endschema %}
