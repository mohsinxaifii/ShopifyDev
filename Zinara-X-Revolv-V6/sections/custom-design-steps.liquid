{%- comment -%}
  "How It Works". Figma: Desktop / Get your own design 7930:95112 >
  Get your own design (7930:95121) > Frame 1116601466.

  A white 32/72 band: the heading with the call-to-action (a plain text button,
  no icon, in the design) pushed to the far side of the row, then three bordered cards laid out sideways - a 108px
  image beside a numbered title and a paragraph.

  The step number comes from the block's position, so reordering the blocks in
  the editor renumbers them rather than leaving a hand-typed number behind.
{%- endcomment -%}

{{ 'custom-design.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    Resolved up here rather than as `| default: 'key' | t`: that chain hands the
    label itself to `t`, which then looks it up as a translation key and
    reports it missing.
  endcomment
  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'custom_design.start' | t
  endif
-%}

<section class="custom-design-steps full-width skeleton-host">
  {%- render 'custom-design-skeleton', cards: section.blocks.size -%}

  <div class="custom-design-steps_wrapper">
    <div class="custom-design-steps_wrapper_head">
      {%- if section.settings.heading != blank -%}
        <h1 class="custom-design-steps_wrapper_head_heading" data-animate>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.cta_url != blank -%}
        <a
          href="{{ section.settings.cta_url }}"
          class="custom-design-steps_wrapper_head_cta"
          target="_blank"
          rel="noopener"
        >
          {{- cta_label -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="custom-design-steps_wrapper_grid" data-animate>
        {%- for block in section.blocks -%}
          <div class="custom-design-steps_wrapper_grid_item" {{ block.shopify_attributes }}>
            <span class="custom-design-steps_wrapper_grid_item_image">
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 216
                  | image_tag: loading: 'lazy', widths: '108,162,216', sizes: '108px', alt: block.settings.title
                }}
              {%- endif -%}
            </span>

            <div class="custom-design-steps_wrapper_grid_item_body">
              <div class="custom-design-steps_wrapper_grid_item_body_head">
                <span class="custom-design-steps_wrapper_grid_item_body_head_number" aria-hidden="true">
                  {{- forloop.index -}}
                </span>
                <h2 class="custom-design-steps_wrapper_grid_item_body_head_title">{{ block.settings.title }}</h2>
              </div>

              <p class="custom-design-steps_wrapper_grid_item_body_text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom design steps",
  "tag": "section",
  "class": "shopify-section--custom-design-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start your design" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Conceptualise" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom design steps",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
