{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'search-suggest.css' | asset_url | stylesheet_tag }}

<header-component class="header full-width" data-drawer-open="false" data-search-open="false">
  <div class="header_wrapper">
    <div class="header_wrapper_brand">
      <button
        type="button"
        class="header_wrapper_brand_menu-toggle"
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-expanded="false"
        aria-controls="header-drawer-{{ section.id }}"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>

      <a href="{{ routes.root_url }}" class="header_wrapper_brand_logo">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag: loading: 'eager', width: settings.logo_width, alt: shop.name
          }}
        {%- else -%}
          {{ 'logo.svg' | inline_asset_content }}
        {%- endif -%}
      </a>
    </div>

    {%- render 'search-suggest' -%}

    <div class="header_wrapper_actions">
      {%- comment -%}
        Figma Mobile navbar 7930:106697 swaps the search field for an icon; it is
        hidden on desktop, where the field itself is always shown.
      {%- endcomment -%}
      <button
        type="button"
        class="header_wrapper_actions_link header_wrapper_actions_search-toggle"
        aria-label="{{ 'accessibility.search' | t }}"
        aria-expanded="false"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>

      <a
        href="{{ routes.account_url }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        {{ 'icon-user.svg' | inline_asset_content }}
      </a>

      <a
        href="{{ section.settings.wishlist_url | default: '#' }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.wishlist' | t }}"
      >
        {{ 'icon-heart.svg' | inline_asset_content }}
      </a>

      <a href="{{ routes.cart_url }}" class="header_wrapper_actions_link" aria-label="{{ 'accessibility.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {%- if cart.item_count > 0 -%}
          <span class="header_wrapper_actions_cart_badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="header_drawer_overlay" inert></div>
  <div
    class="header_drawer"
    id="header-drawer-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    inert
    aria-label="{{ 'accessibility.menu' | t }}"
  >
    {%- comment -%}
      Figma Mobile 7930:108685 (Sidenav): a full-screen sheet - close button on
      top, one divided row per menu item, nested menus as accordions (chevron
      turns from right to down), then login and socials at the foot.
    {%- endcomment -%}
    <div class="header_drawer_header">
      <button type="button" class="header_drawer_header_close" aria-label="{{ 'accessibility.close_menu' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {%- assign badge_titles = section.settings.menu_badge_items | downcase | split: ',' -%}
    <nav class="header_drawer_nav">
      <ul class="header_drawer_nav_list">
        {%- for link in section.settings.menu.links -%}
          {%- liquid
            assign link_key = link.title | downcase | strip
            assign has_badge = false
            for badge_title in badge_titles
              assign badge_key = badge_title | strip
              if badge_key != blank and badge_key == link_key
                assign has_badge = true
              endif
            endfor
          -%}
          <li class="header_drawer_nav_list_item">
            {%- if link.links != blank -%}
              <details class="header_drawer_nav_group"{% if link.child_active %} open{% endif %}>
                <summary class="header_drawer_nav_row{% if link.active %} is-current{% endif %}">
                  <span class="header_drawer_nav_row_label">{{ link.title }}</span>
                  {%- if has_badge -%}
                    <span class="header_drawer_nav_row_badge">{{ section.settings.menu_badge_text }}</span>
                  {%- endif -%}
                  <span class="header_drawer_nav_row_chevron" aria-hidden="true">
                    {{- 'icon-caret-right.svg' | inline_asset_content -}}
                  </span>
                </summary>
                <ul class="header_drawer_nav_sublist">
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        href="{{ childlink.url }}"
                        class="header_drawer_nav_sublist_link{% if childlink.current %} is-current{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- childlink.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="header_drawer_nav_row{% if link.current %} is-current{% endif %}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span class="header_drawer_nav_row_label">{{ link.title }}</span>
                {%- if has_badge -%}
                  <span class="header_drawer_nav_row_badge">{{ section.settings.menu_badge_text }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="header_drawer_nav_foot">
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="header_drawer_nav_foot_account">
            {{- 'icon-user.svg' | inline_asset_content -}}
            <span>{{ 'accessibility.account' | t }}</span>
          </a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="header_drawer_nav_foot_account">
            {{- 'icon-user.svg' | inline_asset_content -}}
            <span>Login</span>
          </a>
        {%- endif -%}

        {%- if section.settings.instagram_url != blank or section.settings.facebook_url != blank -%}
          <div class="header_drawer_nav_foot_social">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                {{- 'icon-instagram.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                {{- 'icon-facebook.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </nav>
  </div>
</header-component>

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-suggest.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "text",
      "id": "menu_badge_items",
      "label": "Menu items with a badge",
      "info": "Menu item titles, comma separated, e.g. Rakhi Collection, New Arrivals."
    },
    {
      "type": "text",
      "id": "menu_badge_text",
      "label": "Badge text",
      "default": "NEW"
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" }
  ]
}
{% endschema %}
