{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'search-suggest.css' | asset_url | stylesheet_tag }}

<header-component class="header full-width" data-drawer-open="false" data-search-open="false">
  <div class="header_wrapper">
    <div class="header_wrapper_brand">
      <button
        type="button"
        class="header_wrapper_brand_menu-toggle"
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-expanded="false"
        aria-controls="header-drawer-{{ section.id }}"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>

      <a href="{{ routes.root_url }}" class="header_wrapper_brand_logo">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag: loading: 'eager', width: settings.logo_width, alt: shop.name
          }}
        {%- else -%}
          {{ 'logo.svg' | inline_asset_content }}
        {%- endif -%}
      </a>
    </div>

    {%- render 'search-suggest' -%}

    <div class="header_wrapper_actions">
      {%- comment -%}
        Figma Mobile navbar 7930:106697 swaps the search field for an icon; it is
        hidden on desktop, where the field itself is always shown.
      {%- endcomment -%}
      <button
        type="button"
        class="header_wrapper_actions_link header_wrapper_actions_search-toggle"
        aria-label="{{ 'accessibility.search' | t }}"
        aria-expanded="false"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>

      <a
        href="{{ routes.account_url }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        {{ 'icon-user.svg' | inline_asset_content }}
      </a>

      <a
        href="{{ section.settings.wishlist_url | default: '#' }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.wishlist' | t }}"
      >
        {{ 'icon-heart.svg' | inline_asset_content }}
      </a>

      <a href="{{ routes.cart_url }}" class="header_wrapper_actions_link" aria-label="{{ 'accessibility.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {%- if cart.item_count > 0 -%}
          <span class="header_wrapper_actions_cart_badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="header_drawer_overlay" inert></div>
  <div
    class="header_drawer"
    id="header-drawer-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    inert
    aria-label="{{ 'accessibility.menu' | t }}"
  >
    {%- comment -%}
      Figma Mobile 7930:109326. A full-height white sheet: a close row, the menu
      as a divided list where any item with children opens as an accordion, and
      an account/social foot pinned to the bottom.
    {%- endcomment -%}
    <div class="header_drawer_header">
      <button type="button" class="header_drawer_header_close" aria-label="{{ 'accessibility.close_menu' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    <div class="header_drawer_body">
      <nav class="header_drawer_nav">
        <ul class="header_drawer_nav_list">
          {%- assign badge_titles = section.settings.new_badge_items | downcase | split: ',' -%}
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign has_children = false
              if link.links != blank
                assign has_children = true
              endif

              assign is_new = false
              assign this_title = link.title | downcase | strip
              for badge in badge_titles
                assign badge_title = badge | strip
                if badge_title != '' and badge_title == this_title
                  assign is_new = true
                endif
              endfor
            -%}
            <li
              class="header_drawer_nav_list_item{% if has_children %} header_drawer_nav_list_item--group{% endif %}"
              {% if has_children %}
                data-nav-group
              {% endif %}
            >
              {%- if has_children -%}
                <button
                  type="button"
                  class="header_drawer_nav_list_item_link header_drawer_nav_list_item_toggle{% if link.active or link.child_active %} is-current{% endif %}"
                  data-nav-toggle
                  aria-expanded="false"
                >
                  <span class="header_drawer_nav_list_item_label">
                    {{- link.title -}}
                    {%- if is_new -%}
                      <span class="header_drawer_nav_list_item_badge">{{ section.settings.new_badge_label }}</span>
                    {%- endif -%}
                  </span>
                  <span class="header_drawer_nav_list_item_caret" aria-hidden="true">
                    {{- 'icon-caret-right.svg' | inline_asset_content -}}
                  </span>
                </button>

                <ul class="header_drawer_nav_sublist" data-nav-panel hidden>
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        href="{{ childlink.url }}"
                        class="header_drawer_nav_sublist_link{% if childlink.active %} is-current{% endif %}"
                      >
                        {{- childlink.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="header_drawer_nav_list_item_link{% if link.active %} is-current{% endif %}"
                >
                  <span class="header_drawer_nav_list_item_label">
                    {{- link.title -}}
                    {%- if is_new -%}
                      <span class="header_drawer_nav_list_item_badge">{{ section.settings.new_badge_label }}</span>
                    {%- endif -%}
                  </span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header_drawer_foot">
        <a href="{{ routes.account_url }}" class="header_drawer_foot_account">
          <span class="header_drawer_foot_account_icon" aria-hidden="true">
            {{- 'icon-user.svg' | inline_asset_content -}}
          </span>
          <span>
            {%- if customer -%}
              {{ customer.first_name | default: 'Account' }}
            {%- else -%}
              {{ 'customer.log_in' | t | default: 'Login' }}
            {%- endif -%}
          </span>
        </a>

        {%- if section.settings.instagram_url != blank or section.settings.facebook_url != blank -%}
          <div class="header_drawer_foot_social">
            {%- if section.settings.instagram_url != blank -%}
              <a
                href="{{ section.settings.instagram_url }}"
                class="header_drawer_foot_social_link"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                {{- 'icon-instagram.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
            {%- if section.settings.facebook_url != blank -%}
              <a
                href="{{ section.settings.facebook_url }}"
                class="header_drawer_foot_social_link"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                {{- 'icon-facebook.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</header-component>

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-suggest.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    },
    {
      "type": "header",
      "content": "Menu drawer"
    },
    {
      "type": "text",
      "id": "new_badge_items",
      "label": "Menu items to badge",
      "info": "Comma separated menu item titles, e.g. \"Rakhi Collection, New Arrivals\"."
    },
    {
      "type": "text",
      "id": "new_badge_label",
      "label": "Badge text",
      "default": "NEW"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ]
}
{% endschema %}
