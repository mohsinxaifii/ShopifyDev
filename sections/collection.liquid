{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Figma: PLP 7930:101927 > Frame 1116601646 (7930:101938).

  The filter rail is driven by Shopify's storefront filters (`collection.filters`),
  so the groups, their values and the counts are whatever Search & Discovery is
  configured to expose - the design's Product type / Colour / Diamond shape /
  Occassion / Collection / Shipping groups are all `list` filters, and Price is
  the one `price_range`. The category chips above the grid are navigational
  rather than filters. On a collection in the catalogue hierarchy (see
  snippets/catalog-path) they are its children - a category shows its
  sub-categories, a sub-category its verticals, a vertical none. Any other
  collection keeps the chips set as section blocks.
{%- endcomment -%}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign category_blocks = section.blocks | where: 'type', 'category'
  capture catalog_path
    render 'catalog-path', collection: collection
  endcapture
  assign catalog_path = catalog_path | strip
-%}

<collection-page
  class="collection full-width"
  data-collection-url="{{ collection.url }}"
  data-analytics-collection="{{ collection.title | escape }}"
>
  {%- render 'plp-skeleton' -%}

  <form
    id="CollectionFilterForm"
    class="collection_wrapper"
    data-filter-form
  >
    {%- comment -%} Keep the chosen sort with the filter params on submit. {%- endcomment -%}
    <input type="hidden" name="sort_by" value="{{ sort_by }}" data-sort-input>

    {%- capture clear_url -%}{{ collection.url }}?sort_by={{ sort_by }}{%- endcapture -%}
    {%- render 'filter-rail',
      filters: collection.filters,
      clear_url: clear_url,
      analytics_collection: collection.title
    -%}

    <div class="collection_wrapper_main">
      {%- comment -%} The design shows no title; this one is for search engines and screen readers. {%- endcomment -%}
      <h1 class="visually-hidden">{{ collection.title }}</h1>
      <div class="collection_wrapper_main_toolbar">
        <p class="collection_wrapper_main_toolbar_count">
          {{- 'collection.product_count' | t: count: collection.products_count -}}
        </p>

        {%- if collection.sort_options.size > 0 -%}
          <div class="collection_wrapper_main_toolbar_sort" data-sort>
            <button
              type="button"
              class="collection_wrapper_main_toolbar_sort_trigger"
              data-sort-trigger
              aria-expanded="false"
            >
              <span class="collection_wrapper_main_toolbar_sort_trigger_label">
                {{ 'collection.sort_by' | t }}
                <strong data-sort-current>
                  {%- for option in collection.sort_options -%}
                    {%- if option.value == sort_by -%}{{ option.name }}{%- endif -%}
                  {%- endfor -%}
                </strong>
              </span>
              <span class="collection_wrapper_main_toolbar_sort_trigger_icon" aria-hidden="true">
                {{- 'icon-caret-down.svg' | inline_asset_content -}}
              </span>
            </button>

            <div class="collection_wrapper_main_toolbar_sort_menu" data-sort-menu hidden>
              <div class="collection_wrapper_main_toolbar_sort_menu_head">
                {{- 'collection.sort_by_heading' | t -}}
                <button
                  type="button"
                  class="collection_wrapper_main_toolbar_sort_menu_head_close"
                  data-sort-close
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </button>
              </div>
              {%- for option in collection.sort_options -%}
                {%- comment -%} "Most relevant" only means something for a search. {%- endcomment -%}
                {%- if option.value == 'relevance' and option.value != sort_by -%}{%- continue -%}{%- endif -%}
                <button
                  type="button"
                  class="collection_wrapper_main_toolbar_sort_menu_item{% if option.value == sort_by %} is-active{% endif %}"
                  data-sort-option
                  value="{{ option.value }}"
                >
                  {{- option.name -}}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if catalog_path != blank -%}
        {%- render 'catalog-chips', path: catalog_path, collection: collection -%}
      {%- elsif category_blocks.size > 0 -%}
        <nav class="collection_wrapper_main_chips" aria-label="{{ 'collection.filters' | t }}">
          {%- for block in category_blocks -%}
            {%- liquid
              assign chip_url = block.settings.url
              assign is_active = false
              if chip_url == blank
                comment
                  The catch-all chip: current whenever no other chip's path is.
                endcomment
                assign chip_url = collection.url
                if forloop.first and request.path == collection.url
                  assign is_active = true
                endif
              elsif chip_url == request.path
                assign is_active = true
              endif
            -%}
            <a
              href="{{ chip_url }}"
              class="collection_wrapper_main_chips_chip{% if is_active %} is-active{% endif %}"
              data-analytics="plp_chip_click"
              data-analytics-chip-name="{{ block.settings.label | escape }}"
              data-analytics-collection-name="{{ collection.title | escape }}"
              data-analytics-position="{{ forloop.index }}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection_wrapper_main_grid" data-grid data-animate-group data-animate-stagger="0.05">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product, variant: 'grid' -%}
          {%- else -%}
            <p class="collection_wrapper_main_grid_empty">{{ 'collection.empty' | t }}</p>
          {%- endfor -%}
        </div>

        {%- if paginate.next -%}
          <div class="collection_wrapper_main_more" data-more>
            {%- comment -%}
              A button, not a link: the next page's cards are added under these
              (collection.js), and the shopper never leaves the page.
            {%- endcomment -%}
            <button
              type="button"
              class="collection_wrapper_main_more_button"
              data-more-link
              data-more-url="{{ paginate.next.url }}"
            >
              <span data-more-label>{{ 'collection.load_more' | t }}</span>
              <span class="collection_wrapper_main_more_button_spinner" aria-hidden="true">
                {{- 'icon-spinner.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </form>

  {%- render 'plp-mobile-bar', filters: collection.filters -%}
</collection-page>



<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "shopify-section--collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 9,
      "max": 48,
      "step": 3,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
