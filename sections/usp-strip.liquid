{{ 'usp-strip.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .usp-strip_wrapper_pill {
    --usp-strip-gradient-start: {{ section.settings.gradient_start }};
    --usp-strip-gradient-middle: {{ section.settings.gradient_middle }};
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section class="usp-strip full-width">
    <div class="usp-strip_wrapper">
      <div class="usp-strip_wrapper_pill" data-animate>
        {%- for block in section.blocks -%}
          {%- liquid
            comment
              A karat mark must never break across lines, so bind the number to
              its unit with a non-breaking space before the label is printed.
            endcomment
            assign badge_text = block.settings.text | replace: ' KT', '&nbsp;KT' | replace: ' Kt', '&nbsp;Kt' | replace: ' kt', '&nbsp;kt'
          -%}
          <div class="usp-strip_wrapper_pill_item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="usp-strip_wrapper_pill_item_icon">
                {%- comment -%}
                  The SGL mark is a raster master, so it is served at its native
                  width with a density set; asking for 72px made it upscale on
                  retina screens. Vector badges ignore the extra candidates.
                {%- endcomment -%}
                {{
                  block.settings.image
                  | image_url: width: 170
                  | image_tag:
                    loading: 'lazy',
                    widths: '54,72,108,144,170',
                    sizes: '(max-width: 749px) 56px, 80px',
                    alt: ''
                }}
              </span>
            {%- endif -%}
            <p class="usp-strip_wrapper_pill_item_text">{{ badge_text }}</p>
          </div>
          {%- unless forloop.last -%}
            <span class="usp-strip_wrapper_pill_divider"></span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "USP strip",
  "tag": "section",
  "class": "shopify-section--usp-strip",
  "settings": [
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Pill gradient start/end",
      "default": "#FEF4E2"
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "Pill gradient middle",
      "default": "#FCE7C5"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon or logo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Badge text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP strip",
      "blocks": [
        { "type": "badge", "settings": { "text": "5x thicker 18 KT gold plating" } },
        { "type": "badge", "settings": { "text": "SGL certified diamonds" } }
      ]
    }
  ]
}
{% endschema %}
