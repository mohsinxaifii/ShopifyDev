{{ 'instagram-feed.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .instagram-feed {
    background-color: {{ section.settings.background_color }};
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section class="instagram-feed instagram-feed--{{ section.settings.layout }} full-width">
    <span class="instagram-feed_wave" aria-hidden="true">{{ 'decorative-wave.svg' | inline_asset_content }}</span>

    <div class="instagram-feed_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="instagram-feed_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="instagram-feed_wrapper_grid" data-animate>
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: 'https://instagram.com' }}"
            class="instagram-feed_wrapper_grid_item"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              assign has_video = false
              if block.settings.video_url != blank or block.settings.video != blank
                assign has_video = true
              endif
            -%}
            {%- if has_video -%}
              {%- comment -%}
                Muted, looping, inline - it plays like a reel while on screen and
                pauses off screen (script below). The image, when set, is the cover.
              {%- endcomment -%}
              {%- if block.settings.video_url != blank -%}
                <video
                  class="instagram-feed_wrapper_grid_item_video"
                  src="{{ block.settings.video_url }}#t=0.1"
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  disableremoteplayback
                  data-feed-video
                  {% if block.settings.image %}
                    poster="{{ block.settings.image | image_url: width: 400 }}"
                  {% endif %}
                ></video>
              {%- else -%}
                <span class="instagram-feed_wrapper_grid_item_video-wrap" data-feed-video-wrap>
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'instagram-feed_wrapper_grid_item_video',
                      muted: true,
                      loop: true,
                      playsinline: true,
                      autoplay: false,
                      controls: false,
                      preload: 'metadata',
                      image_size: '400x'
                  }}
                </span>
              {%- endif -%}
              <span class="instagram-feed_wrapper_grid_item_badge" aria-hidden="true">
                {{- 'icon-play.svg' | inline_asset_content -}}
              </span>
            {%- elsif block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Instagram post' }}
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      <a
        href="{{ section.settings.instagram_url | default: 'https://instagram.com' }}"
        class="instagram-feed_wrapper_follow"
        target="_blank"
        rel="noopener"
      >
        <span>{{ 'accessibility.follow_us' | t }}</span>
        {{ 'icon-instagram.svg' | inline_asset_content }}
        <span class="instagram-feed_wrapper_follow_handle">{{ section.settings.handle }}</span>
      </a>
    </div>
  </section>

  <script>
    // Video tiles play only while they are on screen, and not at all for
    // visitors who prefer reduced motion (they keep the cover frame).
    (() => {
      const section = document.currentScript?.previousElementSibling;
      const videos = section ? section.querySelectorAll('video[data-feed-video], [data-feed-video-wrap] video') : [];
      if (!videos.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      videos.forEach((video) => {
        video.muted = true;
      });
      if (!('IntersectionObserver' in window)) {
        videos.forEach((video) => video.play().catch(() => {}));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(({ target, isIntersecting }) => {
            if (isIntersecting) target.play().catch(() => {});
            else target.pause();
          });
        },
        { threshold: 0.4 },
      );
      videos.forEach((video) => observer.observe(video));
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "shopify-section--instagram-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our Instagram community"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FEF4E2"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@zinara"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Tile layout",
      "options": [
        { "value": "inset", "label": "Centred tiles (home page)" },
        { "value": "fill", "label": "Full-width tiles (contact page)" }
      ],
      "default": "inset"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown on its own, or as the cover while a video loads."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4)",
          "info": "Paste a hosted MP4 URL. Takes priority over the video picker below."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (from library)",
          "info": "Plays muted on a loop while on screen, like a reel."
        },
        { "type": "url", "id": "link", "label": "Link to post" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
