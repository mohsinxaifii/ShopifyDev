{{ 'instagram-feed.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .instagram-feed {
    background-color: {{ section.settings.background_color }};
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section class="instagram-feed instagram-feed--{{ section.settings.layout }} full-width">
    <span class="instagram-feed_wave" aria-hidden="true">{{ 'decorative-wave.svg' | inline_asset_content }}</span>

    <div class="instagram-feed_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="instagram-feed_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="instagram-feed_wrapper_grid" data-animate>
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_video = false
            if block.settings.video_url != blank or block.settings.video != blank
              assign has_video = true
            endif
          -%}
          <a
            href="{{ block.settings.link | default: 'https://instagram.com' }}"
            class="instagram-feed_wrapper_grid_item{% if has_video %} instagram-feed_wrapper_grid_item--video{% endif %}"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            {%- comment -%}
              A tile is either a still or a muted clip. The poster image doubles
              as the placeholder until the clip is in view and starts itself.
            {%- endcomment -%}
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '253,400,506,600',
                  sizes: '(max-width: 749px) 45vw, 253px',
                  alt: 'Instagram post',
                  class: 'instagram-feed_wrapper_grid_item_poster'
              }}
            {%- endif -%}

            {%- if block.settings.video_url != blank -%}
              <video
                class="instagram-feed_wrapper_grid_item_video"
                data-instagram-video
                src="{{ block.settings.video_url }}#t=0.1"
                preload="none"
                muted
                loop
                playsinline
                disableremoteplayback
                aria-hidden="true"
                tabindex="-1"
                {% if block.settings.image != blank %}
                  poster="{{ block.settings.image | image_url: width: 600 }}"
                {% endif %}
              ></video>
            {%- elsif block.settings.video != blank -%}
              <span class="instagram-feed_wrapper_grid_item_video-wrap" data-instagram-video-wrap>
                {{
                  block.settings.video
                  | video_tag:
                    controls: false,
                    muted: true,
                    loop: true,
                    autoplay: false,
                    preload: 'none',
                    image_size: '600x',
                    class: 'instagram-feed_wrapper_grid_item_video'
                }}
              </span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      <a
        href="{{ section.settings.instagram_url | default: 'https://instagram.com' }}"
        class="instagram-feed_wrapper_follow"
        target="_blank"
        rel="noopener"
      >
        <span>{{ 'accessibility.follow_us' | t }}</span>
        {{ 'icon-instagram.svg' | inline_asset_content }}
        <span class="instagram-feed_wrapper_follow_handle">{{ section.settings.handle }}</span>
      </a>
    </div>
  </section>

  <script src="{{ 'instagram-feed.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "shopify-section--instagram-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our Instagram community"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FEF4E2"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@zinara"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Tile layout",
      "options": [
        { "value": "inset", "label": "Centred tiles (home page)" },
        { "value": "fill", "label": "Full-width tiles (contact page)" }
      ],
      "default": "inset"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or video cover",
          "info": "Shown on its own, or as the poster frame for a video below."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4)",
          "info": "Plays muted and loops once the tile scrolls into view. Takes priority over the picker below."
        },
        { "type": "video", "id": "video", "label": "Video (from library)" },
        { "type": "url", "id": "link", "label": "Link to post" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
