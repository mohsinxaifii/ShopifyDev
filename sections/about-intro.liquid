{{ 'about-intro.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns = section.blocks | where: 'type', 'column'
-%}

<section class="about-intro full-width">
  <div class="about-intro_wrapper">
    <div class="about-intro_wrapper_row">
      <div class="about-intro_wrapper_row_text" data-animate>
        {%- if section.settings.heading != blank -%}
          <h2 class="about-intro_wrapper_row_text_heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="about-intro_wrapper_row_text_body">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      {%- if columns.size > 0 -%}
        {%- comment -%}
          Three endless strips: the first runs down, the second up, the third
          down again. Each column's images repeat until a run holds at least
          three tiles (so even one image fills the window), and the run is drawn
          twice so the strip can slide by exactly one run and start over without
          a seam. The speed follows the run's length, so every strip moves at
          the same pace.
        {%- endcomment -%}
        <div class="about-intro_wrapper_row_mosaic" data-animate aria-hidden="true">
          {%- for block in columns limit: 3 -%}
            {%- liquid
              assign image_count = 0
              for i in (1..6)
                assign image_key = 'image_' | append: i
                if block.settings[image_key] != blank
                  assign image_count = image_count | plus: 1
                endif
              endfor
              assign repeats = 1
              if image_count > 0
                assign repeats = 3 | plus: image_count | minus: 1 | divided_by: image_count
              endif
              assign run_length = image_count | times: repeats
              assign duration = run_length | times: 4
            -%}
            <div
              class="about-intro_wrapper_row_mosaic_column about-intro_wrapper_row_mosaic_column--{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {%- if image_count > 0 -%}
                <div class="about-intro_wrapper_row_mosaic_column_track" style="--about-intro-duration: {{ duration }}s;">
                  {%- for copy in (1..2) -%}
                    {%- for repeat in (1..repeats) -%}
                      {%- for i in (1..6) -%}
                        {%- assign image_key = 'image_' | append: i -%}
                        {%- assign tile = block.settings[image_key] -%}
                        {%- if tile != blank -%}
                          <span class="about-intro_wrapper_row_mosaic_column_tile">
                            {{
                              tile
                              | image_url: width: 400
                              | image_tag:
                                loading: 'lazy',
                                widths: '200,300,400',
                                sizes: '(min-width: 750px) 200px, 33vw',
                                alt: ''
                            }}
                          </span>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About intro",
  "tag": "section",
  "class": "shopify-section--about-intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our vision & mission" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Make real gold and real diamond jewellery an everyday choice - not a once-in-a-lifetime event."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Image strip",
      "limit": 3,
      "settings": [
        {
          "type": "paragraph",
          "content": "The first and third strips scroll down, the second up. Every image added here joins this strip, in order."
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Image 5" },
        { "type": "image_picker", "id": "image_6", "label": "Image 6" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About intro",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
