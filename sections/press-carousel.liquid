{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'press-carousel.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <scroll-carousel class="press-carousel full-width" loop>
    <div class="press-carousel_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="press-carousel_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="press-carousel_wrapper_stage">
        <div class="press-carousel_wrapper_track" data-track>
          {%- for block in section.blocks -%}
            {%- liquid
              comment
                The whole card - photo and caption - opens the product worn in
                it. A picked product gives both the link and the name under the
                photo; with no product picked and no Link, the caption is looked
                up as a product name ("Majestic Gleam Solitaire Ring" ->
                /products/majestic-gleam-solitaire-ring).
              endcomment
              assign card_product = block.settings.product
              if card_product == blank and block.settings.link == blank and block.settings.caption != blank
                assign caption_handle = block.settings.caption | handleize
                assign card_product = all_products[caption_handle]
              endif
              assign card_url = card_product.url | default: block.settings.link
              assign card_caption = card_product.title | default: block.settings.caption
              assign card_product_id = card_product.id
              if card_product_id == blank and block.settings.link contains '/products/'
                assign card_product_id = block.settings.link | split: '/products/' | last | split: '?' | first
              endif
              assign card_tag = 'div'
              if card_url != blank
                assign card_tag = 'a'
              endif
            -%}
            <{{ card_tag }}
              class="press-carousel_wrapper_track_item"
              {% if card_url != blank %}
                href="{{ card_url }}"
                data-analytics="celebrity_look_click"
                data-analytics-celebrity-name="{{ block.settings.by_text | strip | remove_last: ' in' | escape }}"
                {% if card_product_id != blank %}
                  data-analytics-product-id="{{ card_product_id }}"
                {% endif %}
                data-analytics-position="{{ forloop.index }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <span class="press-carousel_wrapper_track_item_image">
                {%- if block.settings.image -%}
                  {{
                    block.settings.image
                    | image_url: width: 480
                    | image_tag: loading: 'lazy', alt: card_caption
                  }}
                {%- endif -%}
              </span>
              <span class="press-carousel_wrapper_track_item_caption">
                <span class="press-carousel_wrapper_track_item_caption_by">{{ block.settings.by_text }}</span>
                <span class="press-carousel_wrapper_track_item_caption_title">{{ card_caption }}</span>
              </span>
            </{{ card_tag }}>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="scroll-carousel_arrow press-carousel_wrapper_stage_prev"
          data-prev
          aria-label="{{ 'accessibility.previous_page' | t }}"
        >
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>

        <button
          type="button"
          class="scroll-carousel_arrow press-carousel_wrapper_stage_next"
          data-next
          aria-label="{{ 'accessibility.next_page' | t }}"
        >
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>
  </scroll-carousel>

  <script src="{{ 'carousel-scroll.js' | asset_url }}" defer="defer"></script>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Press carousel",
  "tag": "section",
  "class": "shopify-section--press-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen on"
    }
  ],
  "blocks": [
    {
      "type": "press_card",
      "name": "Press card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "by_text", "label": "By line", "default": "Featured with" },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The product worn in the photo. The whole card links to it."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Only used when no product is picked - a picked product's own name is shown. A caption that is a product's exact name links to that product."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Only used when no product is picked."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press carousel",
      "blocks": [{ "type": "press_card" }, { "type": "press_card" }, { "type": "press_card" }]
    }
  ]
}
{% endschema %}
