{{ 'breadcrumb.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = section.settings.current_label
  if current == blank and page.handle == 'kp-account'
    comment
      KwikPass's account page (sections/page.liquid) - its admin title is
      "kp account".
    endcomment
    assign current = 'My account'
  endif
  if current == blank
    assign current = page.title
  endif
  if current == blank
    assign current = collection.title
  endif
  if current == blank
    assign current = product.title
  endif
  if current == blank
    assign current = article.title
  endif
  if current == blank
    assign current = blog.title
  endif

  comment
    Product pages sit one level deeper than everything else that uses this
    section (Figma PDP 7930:95974 shows Home / collection / product), so a middle
    rung is added only there. `collection` is set when the shopper arrived from a
    collection URL; otherwise fall back to the one chosen in settings, then to
    the product's own first collection. An article sits under its blog the
    same way (Figma 8106:39633: Home / Blogs / article).
  endcomment
  assign parent = null
  if template.name == 'article'
    assign parent = blog
  endif
  if product != blank
    assign parent = collection
    if parent == blank
      assign parent = section.settings.parent_collection
    endif
    if parent == blank
      assign parent = product.collections.first
    endif
  endif

  comment
    A product or collection that sits in the catalogue hierarchy (see
    snippets/catalog-path) shows that instead: Home / Rings / Daily Wear /
    Everyday Minimal / product. On a hierarchy collection the last rung is the
    page itself, so it is the current label rather than a link.
  endcomment
  assign catalog_path = ''
  if product != blank
    capture catalog_path
      render 'catalog-path', product: product
    endcapture
  elsif template.name == 'collection'
    capture catalog_path
      render 'catalog-path', collection: collection
    endcapture
  endif
  assign catalog_path = catalog_path | strip | split: ','
  assign catalog_types = 'catalog_category,catalog_subcategory,catalog_vertical' | split: ','
-%}

{%- liquid
  comment
    The article page wants the trail in a different place per breakpoint -
    under the article on desktop, under the navbar on mobile - and sections
    cannot be reordered by a media query, so the template carries two copies
    and each shows on one side of the breakpoint only.
  endcomment
  assign breadcrumb_class = 'breadcrumb full-width'
  if section.settings.show_on != 'all'
    assign breadcrumb_class = breadcrumb_class | append: ' breadcrumb--' | append: section.settings.show_on | append: '-only'
  endif
  if template.name == 'article'
    assign breadcrumb_class = breadcrumb_class | append: ' breadcrumb--truncate'
  endif
-%}

<nav class="{{ breadcrumb_class }}" aria-label="{{ 'accessibility.breadcrumb' | t }}">
  <ol class="breadcrumb_list">
    <li class="breadcrumb_list_item">
      <a
        href="{{ routes.root_url }}"
        class="breadcrumb_list_item_link"
        data-analytics="breadcrumb_click"
        data-analytics-crumb-text="{{ section.settings.home_label | escape }}"
        data-analytics-crumb-level="1"
      >
        {{- section.settings.home_label -}}
      </a>
    </li>
    {%- if catalog_path.size > 0 -%}
      {%- for node_handle in catalog_path -%}
        {%- liquid
          assign node = metaobjects[catalog_types[forloop.index0]][node_handle]
          assign node_name = node.name.value
          assign node_url = node.collection.value.url
          if product == blank and forloop.last
            assign current = node_name
            break
          endif
        -%}
        <li class="breadcrumb_list_item">
          {%- if node_url != blank -%}
            <a
              href="{{ node_url }}"
              class="breadcrumb_list_item_link"
              data-analytics="breadcrumb_click"
              data-analytics-crumb-text="{{ node_name | escape }}"
              data-analytics-crumb-level="{{ forloop.index | plus: 1 }}"
            >
              {{- node_name -}}
            </a>
          {%- else -%}
            <span class="breadcrumb_list_item_link">{{ node_name }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- elsif parent != blank -%}
      <li class="breadcrumb_list_item">
        <a
          href="{{ parent.url }}"
          class="breadcrumb_list_item_link"
          data-analytics="breadcrumb_click"
          data-analytics-crumb-text="{{ parent.title | escape }}"
          data-analytics-crumb-level="2"
        >
          {{- parent.title -}}
        </a>
      </li>
    {%- endif -%}
    <li class="breadcrumb_list_item">
      <span class="breadcrumb_list_item_current" aria-current="page">{{ current }}</span>
    </li>
  </ol>
</nav>

{% schema %}
{
  "name": "Breadcrumb",
  "tag": "section",
  "class": "shopify-section--breadcrumb",
  "settings": [
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Home" },
    {
      "type": "text",
      "id": "current_label",
      "label": "Current page label",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "collection",
      "id": "parent_collection",
      "label": "Parent collection",
      "info": "Product pages only. Used when the shopper did not arrive from a collection."
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "All screens" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ],
      "default": "all"
    }
  ],
  "presets": [{ "name": "Breadcrumb" }]
}
{% endschema %}
