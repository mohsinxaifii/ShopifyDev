{{ 'shop-by-category.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section class="shop-by-category full-width">
    <div class="shop-by-category_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-by-category_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="shop-by-category_wrapper_grid" data-sbc-track>
        {%- for block in section.blocks -%}
          {%- comment -%}
            The ZNow tile (Figma 8470:77908) opens through the ZNow flow
            (snippets/znow-flow): the loader for shoppers in the same-day
            area, the location dialog for everyone else.
          {%- endcomment -%}
          <a
            href="{{ block.settings.url | default: '#' }}"
            class="shop-by-category_wrapper_grid_item shop-by-category_wrapper_grid_item--{{ block.type }}"
            {% if block.type == 'znow' %}
              data-znow-link
            {% endif %}
            data-analytics="category_click"
            data-analytics-category-name="{{ block.settings.label | escape }}"
            data-analytics-category-url="{{ block.settings.url }}"
            data-analytics-section-name="shop_by_category"
            data-analytics-position="{{ forloop.index }}"
            data-animate
            data-animate-delay="{{ forloop.index0 | times: 80 }}"
            {{ block.shopify_attributes }}
          >
            <span class="shop-by-category_wrapper_grid_item_image">
              {%- if block.type == 'znow' -%}
                <span class="shop-by-category_znow" aria-hidden="true">
                  {{- 'icon-znow-20.svg' | inline_asset_content -}}
                  <span>Now</span>
                </span>
              {%- elsif block.type == 'shop_all' -%}
                <span class="shop-by-category_shop-all" aria-hidden="true">
                  <span class="shop-by-category_shop-all_desktop">{{- 'icon-arrow-right-24.svg' | inline_asset_content -}}</span>
                  <span class="shop-by-category_shop-all_mobile">{{- 'icon-arrow-right-20.svg' | inline_asset_content -}}</span>
                </span>
              {%- elsif block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '300,450,600',
                    sizes: '(min-width: 750px) 266px, 45vw',
                    alt: block.settings.label
                }}
              {%- endif -%}
            </span>
            <span class="shop-by-category_wrapper_grid_item_label">{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <script>
    // Mouse drag for the row once it overflows (touch and trackpads scroll it
    // already); again after the theme editor re-renders the section.
    (() => {
      const init = () =>
        document.querySelectorAll('[data-sbc-track]:not([data-sbc-ready])').forEach((track) => {
          track.dataset.sbcReady = '';
          window.zinaraDragScroll?.(track);
        });
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
      document.addEventListener('shopify:section:load', init);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "shopify-section--shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "znow",
      "name": "ZNow same day",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Same day delivery"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/collections/all",
          "info": "Shoppers outside the same-day area are asked for their pincode first."
        }
      ]
    },
    {
      "type": "shop_all",
      "name": "Shop all",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "label": "Rings" } },
        { "type": "category", "settings": { "label": "Earrings" } },
        { "type": "category", "settings": { "label": "Pendants" } },
        { "type": "category", "settings": { "label": "Bracelets" } }
      ]
    }
  ]
}
{% endschema %}
