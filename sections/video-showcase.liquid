{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'video-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <video-showcase
    class="video-showcase full-width"
    data-fallback-duration="{{ section.settings.fallback_duration | default: 6 }}"
  >
    <div class="video-showcase_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="video-showcase_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="video-showcase_wrapper_stage">
        <div class="video-showcase_wrapper_viewport" data-viewport>
          <div
            class="video-showcase_wrapper_track"
            data-track
            style="--video-showcase-ratio: {{ section.settings.card_ratio | default: '282 / 400' }};"
          >
            {%- for block in section.blocks -%}
              <div
                class="video-showcase_wrapper_track_item"
                data-slide
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <div class="video-showcase_wrapper_track_item_media">
                  {%- if block.settings.cover_image != blank -%}
                    <span class="video-showcase_wrapper_track_item_poster" data-poster>
                      {{
                        block.settings.cover_image
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '282px', alt: ''
                      }}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.video_url != blank -%}
                    <video
                      class="video-showcase_wrapper_track_item_video"
                      data-video
                      src="{{ block.settings.video_url }}#t=0.1"
                      preload="metadata"
                      muted
                      playsinline
                      disableremoteplayback
                      {% if block.settings.cover_image != blank %}
                        poster="{{ block.settings.cover_image | image_url: width: 600 }}"
                      {% endif %}
                    ></video>
                  {%- elsif block.settings.video != blank -%}
                    <span class="video-showcase_wrapper_track_item_video-wrap">
                      {{
                        block.settings.video
                        | video_tag:
                          controls: false,
                          muted: true,
                          autoplay: false,
                          preload: 'metadata',
                          image_size: '600x'
                      }}
                    </span>
                  {%- endif -%}
                </div>

                <span class="video-showcase_wrapper_track_item_scrim" aria-hidden="true"></span>

                <div class="video-showcase_wrapper_track_item_progress" aria-hidden="true">
                  <span class="video-showcase_wrapper_track_item_progress_bar" data-progress></span>
                </div>

                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="video-showcase_wrapper_track_item_link"
                    aria-label="{{ section.settings.heading | default: 'View' | escape }}"
                  ></a>
                {%- endif -%}

                {%- if block.settings.video_url != blank or block.settings.video != blank -%}
                  <button
                    type="button"
                    class="video-showcase_wrapper_track_item_sound"
                    data-sound-toggle
                    aria-label="Unmute video"
                    data-label-muted="Unmute video"
                    data-label-unmuted="Mute video"
                  >
                    <svg class="video-showcase_wrapper_track_item_sound_icon--muted" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M9.5 3.5 5.5 7H3v6h2.5l4 3.5v-13Z" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="m13 7.5 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    <svg class="video-showcase_wrapper_track_item_sound_icon--unmuted" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M9.5 3.5 5.5 7H3v6h2.5l4 3.5v-13Z" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="M13 7.2a4 4 0 0 1 0 5.6M15.3 5a7 7 0 0 1 0 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  </button>
                {%- endif -%}

                <span class="video-showcase_wrapper_track_item_play" data-play-icon>
                  {{ 'icon-play.svg' | inline_asset_content }}
                </span>

                {%- assign card_product = block.settings.product -%}
                {%- if card_product != blank -%}
                  {%- assign card_variant = card_product.selected_or_first_available_variant -%}
                  <div class="video-showcase_wrapper_track_item_product" data-product-card>
                    <a href="{{ card_product.url }}" class="video-showcase_wrapper_track_item_product_info">
                      <span class="video-showcase_wrapper_track_item_product_info_title">{{ card_product.title }}</span>
                      <span class="video-showcase_wrapper_track_item_product_info_price">
                        {%- render 'money', amount: card_variant.price -%}
                        {%- if card_variant.compare_at_price > card_variant.price -%}
                          <s class="video-showcase_wrapper_track_item_product_info_price_compare">
                            {%- render 'money', amount: card_variant.compare_at_price -%}
                          </s>
                        {%- endif -%}
                      </span>
                    </a>

                    {%- if card_product.available -%}
                      <button
                        type="button"
                        class="video-showcase_wrapper_track_item_product_add"
                        data-video-add-to-cart
                        data-variant-id="{{ card_variant.id }}"
                        data-added-label="{{ 'products.added_to_cart' | t | escape }}"
                      >
                        <span data-add-label>{{ 'products.add_to_cart' | t }}</span>
                      </button>
                    {%- else -%}
                      <span class="video-showcase_wrapper_track_item_product_add video-showcase_wrapper_track_item_product_add--disabled">
                        {{- 'products.sold_out' | t -}}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="video-showcase_wrapper_stage_prev"
          data-prev
          aria-label="{{ 'accessibility.previous_page' | t }}"
        >
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>

        <button
          type="button"
          class="video-showcase_wrapper_stage_next"
          data-next
          aria-label="{{ 'accessibility.next_page' | t }}"
        >
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>
  </video-showcase>

  <script src="{{ 'video-showcase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Video showcase",
  "tag": "section",
  "class": "shopify-section--video-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated trends for you"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card shape",
      "info": "Match the aspect ratio of your videos so they are not cropped.",
      "options": [
        { "value": "282 / 400", "label": "Showcase (as designed)" },
        { "value": "9 / 16", "label": "Vertical (9:16)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "282 / 400"
    },
    {
      "type": "range",
      "id": "fallback_duration",
      "label": "Fallback slide duration",
      "info": "Used when a block has no video, or when the video duration cannot be read.",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4)",
          "info": "Paste a hosted MP4 URL. Takes priority over the video picker below."
        },
        { "type": "video", "id": "video", "label": "Video (from library)" },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image (optional)",
          "info": "Leave empty to use the first frame of the video."
        },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Shows a card along the bottom of the video with the title, price and an add to cart button."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video showcase",
      "blocks": [{ "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }]
    }
  ]
}
{% endschema %}
