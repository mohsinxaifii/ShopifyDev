{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'occasion-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <scroll-carousel class="occasion-showcase full-width" loop>
    <div class="occasion-showcase_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="occasion-showcase_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="occasion-showcase_wrapper_stage">
        <div class="occasion-showcase_wrapper_track" data-track>
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.url | default: '#' }}"
              class="occasion-showcase_wrapper_track_item"
              {{ block.shopify_attributes }}
            >
              <span class="occasion-showcase_wrapper_track_item_image">
                {%- if block.settings.image -%}
                  {{
                    block.settings.image
                    | image_url: width: 480
                    | image_tag: loading: 'lazy', widths: '240,360,480', sizes: '240px', alt: block.settings.label
                  }}
                {%- endif -%}
              </span>
              <span class="occasion-showcase_wrapper_track_item_label">{{ block.settings.label }}</span>
            </a>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="scroll-carousel_arrow occasion-showcase_wrapper_stage_prev"
          data-prev
          aria-label="{{ 'accessibility.previous_page' | t }}"
        >
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>

        <button
          type="button"
          class="scroll-carousel_arrow occasion-showcase_wrapper_stage_next"
          data-next
          aria-label="{{ 'accessibility.next_page' | t }}"
        >
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>
  </scroll-carousel>

  <script src="{{ 'carousel-scroll.js' | asset_url }}" defer="defer"></script>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Occasion showcase",
  "tag": "section",
  "class": "shopify-section--occasion-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For every occasion"
    }
  ],
  "blocks": [
    {
      "type": "occasion_card",
      "name": "Occasion card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Occasion" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Occasion showcase",
      "blocks": [
        { "type": "occasion_card", "settings": { "label": "New job, new era" } },
        { "type": "occasion_card", "settings": { "label": "Festive edit" } },
        { "type": "occasion_card", "settings": { "label": "Monsoon edit" } }
      ]
    }
  ]
}
{% endschema %}
