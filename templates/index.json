    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are lab grown diamonds real?",
            "answer": "Lab grown diamonds appear identical to natural diamonds and can't be distinguished by the naked eye and with standard microscopic tools. Trained jewellers and experts can't also tell the difference between them. They can only be distinguished from natural diamonds using specialized equipment that can detect the specific growth patterns and inclusions characteristic of their origin."
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can you tell the difference between lab grown diamonds and natural diamonds?",
            "answer": "Lab grown diamonds appear identical to natural diamonds and can’t be distinguished by the naked eye and with standard microscopic tools. Trained jewellers and experts can’t also tell the difference between them. They can only be distinguished from natural diamonds using specialized equipment that can detect the specific growth patterns and inclusions characteristic of their origin."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Are ZINARA lab grown diamonds graded and certified?",
            "answer": "Yes, lab grown diamonds are graded and certified by the same gemological laboratories that evaluate natural diamonds. Renowned organizations like GIA, IGI, and SGL provide these certifications. The grading process for lab grown diamonds is identical to that for natural diamonds, ensuring transparency and quality assurance. All lab grown diamonds used in jewellery offered by ZINARA are graded and certified by these laboratory organizations."
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do you deliver pan India?",
            "answer": "Yes we deliver PAN India to 19000+ pincodes. To check if we deliver to your area, please enter your pincode or city on the product page."
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Is ID proof required for delivery?",
            "answer": "Some logistics partners may request ID proof, especially for high-value shipments, to ensure secure delivery."
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What payment options are available?",
            "answer": "Payment methods include credit cards, debit cards, net banking, international cards, and cash on delivery. Cash on delivery is available upto INR 35000"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],
